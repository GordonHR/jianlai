/* 天下舆图 · 全屏矢量地图页
 * 地图画布铺满整屏，所有控件以半透明浮层压在其上（真地图观感）。
 * 自定义导航：顶部让出状态栏 + 微信胶囊高度，工具条落在胶囊之下不遮挡。 */
page { height:100%; background:#0f0d0b; }

.mp { position:relative; width:100%; height:100vh; overflow:hidden; background:#0f0d0b; }
.mp-stage { position:absolute; left:0; top:0; right:0; bottom:0; overflow:hidden; }
.mp-cv { width:100%; height:100%; display:block; }

/* 顶部渐隐：保证状态栏时间/信号在浅色海面上也可读 */
.mp-fade-t { position:absolute; left:0; right:0; top:0; height:180rpx;
  height:calc(env(safe-area-inset-top) + 140rpx);
  pointer-events:none; z-index:9;
  background:linear-gradient(180deg, rgba(8,7,6,.62), rgba(8,7,6,0)); }

/* ---------- 顶部浮动工具条（落在胶囊下方） ---------- */
.mp-top { position:absolute; left:16rpx; right:16rpx;
  top:124rpx; top:calc(env(safe-area-inset-top) + 76rpx);
  height:76rpx; z-index:12; box-sizing:border-box;
  display:flex; align-items:center; padding:0 10rpx;
  background:rgba(25,21,18,.86); border:1rpx solid #3a2f23; border-radius:14rpx; }
.mp-back { font-size:24rpx; color:#c9a24b; padding:8rpx 14rpx;
  border:1rpx solid #3a2f23; border-radius:8rpx; margin-right:12rpx; }
.mp-crumb { flex:1; min-width:0; font-size:24rpx; color:#e8e0d2; letter-spacing:1rpx;
  overflow:hidden; white-space:nowrap; text-overflow:ellipsis; }
.mp-tbtn { font-size:22rpx; color:#c9a24b; padding:8rpx 16rpx;
  border:1rpx solid #3a2f23; border-radius:8rpx; margin-left:8rpx; }

/* ---------- 缩放 / 返回目录 ---------- */
.mp-zoom { position:absolute; right:24rpx; z-index:11;
  bottom:164rpx; bottom:calc(env(safe-area-inset-bottom) + 132rpx);
  display:flex; flex-direction:column; gap:12rpx; }
.mp-zbtn { width:68rpx; height:68rpx; line-height:68rpx; text-align:center; font-size:30rpx;
  color:#e8e0d2; background:rgba(25,21,18,.86); border:1rpx solid #3a2f23; border-radius:12rpx; }
.mp-home { position:absolute; left:24rpx; z-index:11; font-size:22rpx; color:#c9a24b;
  bottom:164rpx; bottom:calc(env(safe-area-inset-bottom) + 132rpx);
  padding:12rpx 18rpx; background:rgba(25,21,18,.86);
  border:1rpx solid #3a2f23; border-radius:12rpx; }

/* ---------- 浮层面板 ---------- */
.mp-pop { position:absolute; left:16rpx; width:440rpx; z-index:14;
  top:212rpx; top:calc(env(safe-area-inset-top) + 164rpx);
  background:rgba(20,17,14,.97); border:1rpx solid #3a2f23; border-radius:14rpx; padding:18rpx; }
.mp-pop.right { left:auto; right:16rpx; width:320rpx; }
.mp-pop.wide { left:16rpx; right:16rpx; width:auto; }
.mp-pop-h { font-size:21rpx; color:#8a7e6c; margin-bottom:12rpx; letter-spacing:1rpx; }
.mp-opts { display:flex; flex-wrap:wrap; gap:12rpx; }
.mp-opt { font-size:23rpx; color:#b9ab93; padding:10rpx 20rpx;
  border:1rpx solid #3a2f23; border-radius:8rpx; }
.mp-opt.on { color:#14110f; background:#c9a24b; border-color:#c9a24b; }
.mp-input { height:64rpx; font-size:24rpx; color:#e8e0d2; background:#221c17;
  border:1rpx solid #3a2f23; border-radius:8rpx; padding:0 18rpx; }
.mp-ph { color:#6e6355; }
.mp-hits { max-height:420rpx; margin-top:12rpx; }
.mp-hit { display:flex; justify-content:space-between; align-items:center; padding:16rpx 8rpx;
  border-bottom:1rpx solid #2a231c; }
.mp-hit-n { font-size:24rpx; color:#e8e0d2; }
.mp-hit-s { font-size:20rpx; color:#8a7e6c; }

/* ---------- 底部快捷条（浮在图上） ---------- */
.mp-strip { position:absolute; left:16rpx; right:16rpx; height:88rpx; z-index:12;
  bottom:16rpx; bottom:calc(env(safe-area-inset-bottom) + 16rpx);
  white-space:nowrap; padding:0 8rpx; box-sizing:border-box;
  background:rgba(25,21,18,.86); border:1rpx solid #3a2f23; border-radius:14rpx; }
.mp-chip { display:inline-block; font-size:23rpx; color:#c9a24b; padding:12rpx 22rpx;
  border:1rpx solid #3a2f23; border-radius:8rpx; margin:14rpx 10rpx 0 0; }
.mp-chip.on { color:#14110f; background:#c9a24b; border-color:#c9a24b; }

/* ---------- 详情 / 考据面板 ---------- */
.mp-mask { position:fixed; left:0; top:0; right:0; bottom:0; background:rgba(0,0,0,.55); z-index:20; }
.mp-sheet { position:fixed; left:0; right:0; bottom:0; z-index:21; background:#1a1512;
  border-top:1rpx solid #3a2f23; border-radius:16rpx 16rpx 0 0;
  padding:24rpx 26rpx 30rpx; padding-bottom:calc(env(safe-area-inset-bottom) + 30rpx); }
.mp-sheet.lizhu { top:0; bottom:0; border-radius:0; padding-top:34rpx; }
.mp-sheet-hd { display:flex; align-items:center; gap:12rpx; padding-bottom:16rpx;
  border-bottom:1rpx solid #2a231c; }
.mp-sheet-tag { font-size:20rpx; color:#14110f; background:#c9a24b; padding:4rpx 12rpx; border-radius:6rpx; }
.mp-sheet-n { flex:1; font-size:28rpx; color:#e8e0d2; letter-spacing:1rpx; }
.mp-sheet-x { font-size:30rpx; color:#8a7e6c; padding:0 8rpx; }
.mp-sheet-bd { max-height:52vh; }
.mp-sheet.lizhu .mp-sheet-bd { max-height:82vh; }
.mp-sheet-d { font-size:25rpx; color:#cdbfa8; line-height:1.75; margin-top:20rpx; white-space:pre-wrap; }
.mp-chars { margin-top:26rpx; }
.mp-chars-t { font-size:21rpx; color:#8a7e6c; margin-bottom:12rpx; }
.mp-chips { display:flex; flex-wrap:wrap; gap:12rpx; }
.mp-foot { font-size:20rpx; color:#6e6355; margin:26rpx 0 10rpx; line-height:1.6; }

.mp-lz-tag { font-size:22rpx; color:#c9a24b; margin:22rpx 0 8rpx; letter-spacing:1rpx; }
.mp-lz-item { padding:14rpx 6rpx; border-bottom:1rpx solid #241e19; }
.mp-lz-n { font-size:25rpx; color:#e8e0d2; }
.mp-lz-d { font-size:22rpx; color:#a89b85; line-height:1.7; margin-top:10rpx; }
