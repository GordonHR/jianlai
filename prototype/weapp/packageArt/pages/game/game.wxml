<view class="game" wx:if="{{s}}">

  <!-- 顶栏 -->
  <view class="topbar">
    <view class="turn-banner">
      <text class="phase">第 {{s.round}} 轮</text>
      <text wx:if="{{s.mode==='siege'}}" class="phase siege">守城 {{s.wave}} / {{s.maxWave}} 波</text>
      <text wx:if="{{s.mode==='boss'}}" class="phase boss">共伐 {{s.result? '' : ''}}{{s.deckCount>=0 ? '' : ''}}</text>
      <text class="turn" style="color:{{s.currentPlayer.col}}">{{s.currentPlayer.name}}</text>
      <text class="tfac" style="color:{{s.currentPlayer.col}}">{{s.currentPlayer.faction}}</text>
      <view class="stepper">
        <text class="st {{s.tphase==='draw'?'on':(s.tphase==='judge'||s.tphase==='play'||s.tphase==='discard'?'done':'')}}">摸牌</text>
        <text class="arw">›</text>
        <text class="st {{s.tphase==='judge'?'on':(s.tphase==='play'||s.tphase==='discard'?'done':'')}}">判定</text>
        <text class="arw">›</text>
        <text class="st {{s.tphase==='play'?'on':(s.tphase==='discard'?'done':'')}}">出牌</text>
        <text class="arw">›</text>
        <text class="st {{s.tphase==='discard'?'on':''}}">弃牌</text>
      </view>
    </view>
    <view class="topctrl">
      <text class="counts">库 {{s.deckCount}} · 弃 {{s.discardCount}}</text>
      <view class="bg-btn" bindtap="cycleBg">换景</view>
      <view class="bg-btn {{speedOn?'':'off'}}" bindtap="toggleSpeed">节奏 {{speedOn?'缓':'疾'}}</view>
      <view class="bg-btn" bindtap="toggleSfx">音 效</view>
      <view class="bg-btn {{s.auto?'on':''}}" bindtap="tapAuto" title="交给 AI 代打，再点一次收回">{{s.auto?'托管 中':'托 管'}}</view>
      <view class="btn {{!s.isMyTurn||s.busy||s.await?'disabled':''}}" bindtap="tapEndTurn">结束回合</view>
    </view>
  </view>

  <!-- 战场：四角站位，中间舞台 -->
  <view class="battlefield">
    <!-- 战场景别：换景按钮驱动的纯 CSS 景（零资源），中央古风环纹对齐三国杀舞台浮雕 -->
    <view class="battle-bg sc-{{s.bgIdx}}">
      <view class="bg-ring"></view>
      <view class="bg-ring2"></view>
      <text class="bg-char">剑</text>
    </view>
    <!-- 座位卡模板：小头像，供四角使用 -->
    <template name="seatCard">
      <view class="seat {{item.dead?'dead':''}} {{item.canTarget?'clickable':''}} {{item.isCurrent?'current':''}} {{item.shake?'shake':''}} {{item.glow?'glow':''}}" style="border-color:{{item.col}}" bindtap="tapPlayer" data-id="{{item.id}}">
        <view class="seat-portrait">
          <text wx:if="{{!item.art}}" class="seat-initial" style="color:{{item.col}}">剑来</text>
          <image wx:else src="{{item.art}}" class="seat-img" mode="aspectFill"/>
          <view class="seat-name">{{item.name}}</view>
          <view class="seat-fac" style="--fac:{{item.col}};color:{{item.col}}">{{item.faction}}</view>
          <view class="seat-hp">气血 {{item.hp}}</view>
          <view wx:if="{{item.equipName && !item.dead}}" class="seat-equip">{{item.equipName}}</view>
          <view wx:if="{{!item.dead}}" class="seat-cnt">{{item.handCount}}</view>
          <view wx:if="{{item.dead}}" class="seat-dead"><view class="sd-stamp">阵 亡</view><view class="seat-left-tag">已离开</view></view>
          <view wx:if="{{item.isCurrent && item.ai}}" class="seat-thinking">出牌思考中</view>
          <view wx:if="{{item.canTarget}}" class="seat-tgt">▼</view>
          <view wx:if="{{item.isCurrent && !item.ai}}" class="seat-turn">你的回合</view>
        </view>
        <view wx:if="{{item.seatLabel || item.sideLabel}}" class="seat-foot"><text class="sf-seat">{{item.seatLabel}}</text><text wx:if="{{item.sideLabel}}" class="sf-side">{{item.sideLabel}}</text></view>
      </view>
    </template>

    <!-- 顶部：敌方 -->
    <view class="seat-top" wx:if="{{s.opps.length}}">
      <view class="seat-scroll">
        <template is="seatCard" wx:for="{{s.opps}}" wx:key="id" data="{{item}}"/>
      </view>
    </view>

    <!-- 左侧：第二个敌方（4 人局） -->
    <view class="seat-left" wx:if="{{s.opps.length>1}}">
      <template is="seatCard" data="{{item:s.opps[1]}}"/>
    </view>

    <!-- 右侧：队友 -->
    <view class="seat-right" wx:if="{{s.mates.length}}">
      <template is="seatCard" data="{{item:s.mates[0]}}"/>
    </view>

    <!-- 中间核心：仅演出时显示（playName 非空时浮出，平时收起） -->
    <view class="stage" wx:if="{{playName}}">
      <view class="stage-play">
        <text class="sp-name">{{playName}}</text>
      </view>
    </view>

    <!-- 选目标提示：await 状态下在战场顶部中央浮出一条提示（替代把手牌区挤变形） -->
    <view wx:if="{{s.await}}" class="await-prompt">
      <text class="ap-arrow">▼</text>
      <view class="ap-text">请为【{{s.await.label}}】点击一名角色选为目标</view>
    </view>

    <!-- 战报：右下角小浮标「报」+ 数字，展开为底部浮层 -->
    <view class="log-fab {{!logCollapsed?'on':''}}" bindtap="toggleLog">
      <text class="log-fab-t">报</text>
      <text wx:if="{{s.stageLog.length}}" class="log-fab-n">{{s.stageLog.length}}</text>
    </view>
    <view wx:if="{{!logCollapsed}}" class="log-pop">
      <view class="log-pop-h">战 报<view class="log-pop-x" bindtap="toggleLog">×</view></view>
      <scroll-view scroll-y class="log-pop-b">
        <view wx:for="{{s.stageLog}}" wx:key="index" class="lg lg-{{item.c}}">{{item.t}}</view>
      </scroll-view>
    </view>

    <!-- 底部：自己 + 手牌 + 技能 -->
    <view class="seat-bottom">
      <view class="my-card {{s.me.dead?'dead':''}}" style="border-color:{{s.me.col}}">
        <view class="my-portrait">
          <text wx:if="{{!s.me.art}}" class="my-initial" style="color:{{s.me.col}}">剑来</text>
          <image wx:else src="{{s.me.art}}" class="my-img" mode="aspectFill"/>
          <view class="my-name">{{s.me.name}}</view>
          <view class="my-hp">气血 {{s.me.hp}}</view>
          <view class="my-hpbar"><view class="my-hpbar-fill" style="width:{{s.me.hpPct}}%"></view></view>
          <view wx:if="{{s.me.seatLabel}}" class="my-seat">{{s.me.seatLabel}}</view>
          <view wx:if="{{s.me.dead}}" class="my-dead"><view class="sd-stamp">阵 亡</view></view>
        </view>
        <view class="my-extra">
          <text class="my-qi">剑气 {{s.me.attackUsed}}/{{s.me.attackLimit}}</text>
          <text wx:if="{{s.me.wineActive}}" class="my-wenjian">· 问剑已饮</text>
          <text wx:if="{{s.me.equipName}}" class="my-equip">· {{s.me.equipName}}</text>
        </view>
      </view>
      <view class="my-area">
        <view class="my-title">
          <text>{{s.me.name}} 的手牌</text>
          <text wx:if="{{s.meTrustee}}" class="trustee-tag">· 托管中</text>
          <text class="atkinfo">上限 {{s.me.handLimit}} · 剑气 {{s.me.attackUsed}}/{{s.me.attackLimit}}</text>
          <text wx:if="{{s.me.wineActive}}" class="wine">· 问剑已饮</text>
        </view>

        <!-- 出牌确认条：抬起后浮现 -->
        <view class="play-bar" wx:if="{{selUid !== null && !s.await && s.isMyTurn && !modalType}}">
          <view class="btn primary" bindtap="tapConfirmPlay">出 牌</view>
          <view class="btn ghost" bindtap="tapCancelSel">取 消</view>
        </view>

        <!-- 手牌：始终横向铺开，溢出滚动 -->
        <block wx:if="{{!s.await}}">
          <scroll-view scroll-x class="hand-scroll">
            <view class="hand-row">
              <view wx:for="{{s.meHand}}" wx:key="uid" class="card {{item.cls}} {{item.uid===selUid?'sel':''}} {{modalType==='multi' ? (pickSel.indexOf(item.uid)>=0?'mp-on':'mp') : (item.disabled?'disabled':'')}}" bindtap="tapCard" data-uid="{{item.uid}}">
                <view class="cf-head"><text class="cf-point">{{item.point}}</text>{{item.name}}</view>
                <view class="cf-art {{item.cls?'has-img':''}}">
                  <text class="cf-sig">{{item.sig}}</text>
                  <image wx:if="{{item.cls}}" class="cf-img" src="/packageArt/assets/card/card-{{item.type}}.svg" mode="aspectFit"/>
                </view>
                <view class="cf-foot">{{item.kind}}</view>
              </view>
              <view wx:if="{{s.meHand.length===0}}" class="wait">两手空空。</view>
            </view>
          </scroll-view>
        </block>
        <view class="hand" wx:else>
          <view class="wait">等待选目标中…</view>
          <view class="btn ghost cancel-await" bindtap="tapCancelAwait">取 消</view>
        </view>
        <!-- 技能按钮：我的回合才出现，默认折叠成右下"技"浮标，点击展开面板 -->
        <block wx:if="{{s.meSkills.length && !s.await && s.isMyTurn && !s.auto && !modalType}}">
          <view wx:if="{{skillFolded}}" class="skill-fab" bindtap="toggleSkillFold">
            <text class="skill-fab-t">技</text>
            <text class="skill-fab-n">{{s.meSkills.length}}</text>
          </view>
          <view wx:else class="skill-pop">
            <view wx:for="{{s.meSkills}}" wx:key="key" class="btn skill" bindtap="tapSkill" data-key="{{item.key}}">{{item.label}}</view>
            <view class="btn skill close" bindtap="toggleSkillFold">收</view>
          </view>
        </block>
      </view>
    </view>

    <!-- 浮动底栏：左下排序 + 右下表情/聊天（对齐三国杀，不用 emoji，用古风文字） -->
    <view class="float-bar">
      <view class="float-btn sort-btn" bindtap="tapSortHand">排 序</view>
      <view class="float-right">
        <view class="float-btn chat-emoji" bindtap="tapEmoji">笑</view>
        <view class="float-btn chat-msg" bindtap="tapChat">言</view>
      </view>
    </view>
  </view>

  <!-- 普通抉择弹窗 -->
  <view wx:if="{{s.modal && s.modal.type==='choice'}}" class="modal-mask">
    <view class="modal-frame">
      <view class="modal-crest">
        <view class="crest-sword sl"></view>
        <view class="crest-sword sr"></view>
        <view class="crest-seal"></view>
      </view>
      <view class="modal-prompt">{{s.modal.title}}</view>
      <view class="modal-seal-btns">
        <view wx:for="{{s.modal.options}}" wx:key="v" class="seal-btn {{index===0?'primary':''}}" bindtap="modalChoice" data-v="{{item.v}}">{{item.t}}</view>
      </view>
      <view class="modal-roll-end"><view></view><view></view></view>
    </view>
  </view>

  <!-- 弃牌等多选（对齐三国杀）：不弹遮罩框，直接在手牌上多选，中央浮出确认条 -->
  <view wx:if="{{modalType==='multi' && s.modal}}" class="multi-bar">
    <view class="mb-btns">
      <view class="btn primary {{pickSel.length===s.modal.count?'':'disabled'}}" bindtap="tapMultiConfirm">{{s.modal.confirmLabel || '确 定'}}</view>
      <view class="mb-count">{{pickSel.length}} / {{s.modal.count}}</view>
    </view>
    <view class="mb-text">{{s.modal.title}}</view>
  </view>

  <!-- 结算覆盖层 -->
  <view wx:if="{{s.over && s.result}}" class="result-mask">
    <view class="result">
      <view wx:if="{{s.result.mvp}}" class="rs-mvp-wrap">
        <view class="rs-mvp-banner">
          <view class="rs-mvp-flame-t"></view>
          <view class="rs-mvp-banner-t">全 场 最 佳</view>
          <view class="rs-mvp-flame-b"></view>
          <small>{{s.result.banner}}</small>
        </view>
        <view class="rs-mvp-card" style="--col:{{s.result.mvp.col}}">
          <view class="rs-mvp-art"><image src="{{s.result.mvp.art}}" mode="aspectFill" class="rsmvpi"></image></view>
          <view class="rs-mvp-flame"></view>
          <view class="rs-mvp-name" style="color:{{s.result.mvp.col}}">{{s.result.mvp.name}}<view class="mvp-fac">{{s.result.mvp.facLab}} · {{s.result.mvp.realm}}</view></view>
        </view>
        <view class="rs-mvp-stats">
          <view class="rs-mvp-stat"><b>{{s.result.mvp.kills}}</b><text>斩 杀</text></view>
          <view class="rs-mvp-stat"><b>{{s.result.mvp.dmg}}</b><text>造 伤</text></view>
          <view class="rs-mvp-stat"><b>{{s.result.mvp.heal}}</b><text>疗 愈</text></view>
        </view>
      </view>
      <view wx:elif="{{s.result.rows[0].art}}" class="rs-lose-card"><image src="{{s.result.rows[0].art}}" mode="aspectFill" class="rslci"/></view>
      <view wx:if="{{s.result.achievement}}" class="rs-ach {{s.result.win?'rs-ach-win':'rs-ach-lose'}} rs-grade-{{s.result.achievement.gkey}}">
        <view class="rs-ach-grade">{{s.result.achievement.grade}} · 本 局 成 就</view>
        <view class="rs-ach-title">{{s.result.achievement.title}}</view>
        <view class="rs-ach-note">{{s.result.achievement.note}}</view>
      </view>
      <view class="rs-title {{s.result.win?'win':'lose'}}">{{s.result.win?'胜':'败'}}</view>
      <view class="rs-sub">{{s.result.sub}}</view>
      <!-- 包袱斋结账：本局雪花钱得数（原先只悄悄入账，玩家打完不知赚了多少） -->
      <view wx:if="{{s.result.coinGain && s.result.coinGain.gain>0}}" class="rs-coin">
        <text class="rc-k">雪 花 钱</text>
        <text class="rc-v">+{{s.result.coinGain.gain}}</text>
        <text wx:if="{{s.result.coinGain.pay>0}}" class="rc-pay">抵赊欠 {{s.result.coinGain.pay}}</text>
        <text class="rc-net">囊中结余 {{s.result.coinGain.coin}}</text>
      </view>
      <view class="rs-stats">
        <view class="rs-row rs-head"><text>人物</text><text>阵营</text><text>境</text><text>斩</text><text>伤</text><text>承</text><text>疗</text></view>
        <view wx:for="{{s.result.rows}}" wx:key="name" class="rs-row {{item.win?'win-row':''}}">
          <text>{{item.name}}</text><text style="color:{{item.col}}">{{item.faction}}</text><text>{{item.realm}}</text>
          <text>{{item.kills}}</text><text>{{item.dmg}}</text><text>{{item.taken}}</text><text>{{item.heal}}</text>
        </view>
      </view>
      <view class="rs-recap-bar" bindtap="toggleRecap">
        <text>本 局 战 报（{{s.result.logFull.length}} 条）</text>
        <text class="rs-recap-arw">{{recapOn?'收 起':'展 开'}}</text>
      </view>
      <scroll-view wx:if="{{recapOn}}" scroll-y class="rs-recap">
        <view wx:for="{{s.result.logFull}}" wx:key="index" class="lg lg-{{item.c}}">{{item.t}}</view>
      </scroll-view>
      <view class="rs-btns">
        <view class="btn primary" bindtap="resultRematch">再 战</view>
        <view class="btn ghost" bindtap="resultHome">回到卷首</view>
      </view>
    </view>
  </view>

  <!-- 瞬时特效 -->
  <view wx:if="{{bannerOn && banner}}" class="banner-fx"><view class="bn-name">{{banner.name}}</view><view class="bn-sub">{{banner.sub}}</view></view>
  <view wx:if="{{flashOn && flash}}" class="flash-fx"><view class="exec-word">斩</view><view class="exec-sub">{{flash.sub}}</view></view>
  <view wx:if="{{shoutOn && shout}}" class="shout-fx" style="color:{{shout.color}}">{{shout.text}}<view class="shout-seal"><view class="shout-seal-inner">{{shout.seal}}</view></view></view>
  <view wx:if="{{popupOn && popup}}" class="popup-fx {{popup.type}}">{{popup.type==='heal'?'+':''}}{{popup.type==='heal'?'':'-'}}{{popup.amt}}</view>

  <!-- 全局剑气 / 万剑归宗 / 蛮荒入侵 -->
  <view class="fxglobal">
    <block wx:for="{{s.fx}}" wx:key="key">
      <view wx:if="{{item.pid===null}}" class="gfx gfx-{{item.type}}" style="{{item.col?('--col:'+item.col+';color:'+item.col+';'):''}}">
        <block wx:if="{{item.type==='swordrain'}}">
          <text class="rain r1">剑</text><text class="rain r2">剑</text><text class="rain r3">剑</text><text class="rain r4">剑</text><text class="rain r5">剑</text><text class="rain r6">剑</text>
        </block>
      </view>
    </block>
  </view>
</view>

<view wx:else class="loading">布阵中…</view>
