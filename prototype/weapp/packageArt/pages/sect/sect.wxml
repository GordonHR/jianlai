<view class="sect">
  <!-- 结局 -->
  <block wx:if="{{v.over}}">
    <view class="sect-ending">
      <image wx:if="{{v.ending.img}}" class="sect-end-img" src="{{v.ending.img}}" mode="widthFix"/>
      <view class="grade {{v.ending.g}}">{{v.ending.g}}</view>
      <view class="et">{{v.ending.t}}</view>
      <view class="ed">
        <text wx:for="{{v.ending.dLines}}" wx:key="*this" wx:for-item="ln">{{ln}}\n</text>
      </view>
      <view class="ep">「{{v.ending.poem}}」</view>
      <view class="recap">
        <text wx:for="{{v.ending.recapLines}}" wx:key="*this" wx:for-item="rl">{{rl}}\n</text>
      </view>
      <view class="sect-back">
        <button class="sect-btn primary" bindtap="restart">重 开 一 局</button>
        <button class="sect-btn ghost" bindtap="back">回到卷首</button>
      </view>
    </view>
  </block>

  <!-- ===================== 本 旬 中 转 ===================== -->
  <block wx:elif="{{v.settling && v.settle}}">
    <view class="sect-settle">
      <view class="st-head">本 旬 已 了</view>
      <view class="st-sub">第 {{v.settle.year}} 年 · 第 {{v.settle.xun}} 旬 · {{v.settle.season}}</view>

      <view class="st-ledger">
        <view class="st-row {{item.cls}}" wx:for="{{v.settle.ledger}}" wx:key="k">
          <view class="st-k">{{item.k}}</view>
          <view class="st-v">{{item.dTxt}}</view>
        </view>
      </view>

      <view class="st-notes" wx:if="{{v.settle.notes.length}}">
        <view class="st-note" wx:for="{{v.settle.notes}}" wx:key="*this">{{item}}</view>
      </view>

      <view class="st-backlog" wx:if="{{v.settle.backlogLeft > 0}}">尚有 {{v.settle.backlogLeft}} 桩积压，悬而未决。</view>

      <button class="sect-btn primary" bindtap="enterNext">入 下 一 旬 →</button>
    </view>
  </block>

  <block wx:else>
    <!-- 头部：极简，只留关键状态 -->
    <view class="sect-head">
      <view class="sect-headline">
        <view class="sect-sub">山主 · 陈平安 · {{v.masterRealmName}}境 · 第 {{v.year}} 年</view>
        <view class="sect-act">第 {{v.book.act}} 幕 · {{v.book.actName}} ｜ 第 {{v.book.bookIdxInAct}}/{{v.book.bookCountInAct}} 册《{{v.book.book}}》</view>
      </view>
      <view class="sect-timer">第 <text class="b">{{v.xunInYear}}</text> 旬 · <text class="sect-season">{{v.season}}</text> · 距建宗大典尚有 <text class="b">{{v.ascendLeft}}</text> 旬
        <text class="sub2">山主修为 {{v.masterCult}} {{v.nextNeed==null ? '（已至绝顶）' : '· 下境需 '+v.nextNeed}}</text>
      </view>
    </view>

    <!-- 资源 -->
    <view class="sect-res">
      <view class="sect-res-i" wx:for="{{v.res}}" wx:key="k">
        <image class="ico" src="{{item.ico}}" mode="aspectFit"/>
        <view class="k">{{item.lab}}</view>
        <view class="v {{item.cls}}">{{item.v}}</view>
      </view>
    </view>

    <!-- 节点 -->
    <view class="sect-nodes">
      <view class="sect-node {{item.cls}}" wx:for="{{v.nodes}}" wx:key="key">
        {{item.name}}<view class="bar"><view class="i" style="width:{{item.prog}}%"></view></view>
      </view>
    </view>

    <!-- 山中一瞬：叙事节拍 -->
    <view class="sect-mood" wx:if="{{v.moodLine}}">「{{v.moodLine}}」</view>

    <!-- 册首语 -->
    <view class="sect-prologue" wx:if="{{v.prologue}}">
      <image wx:if="{{v.prologue.img}}" class="sect-prologue-img" src="/packageArt/assets/sect/{{v.prologue.img}}.jpg" mode="widthFix"/>
      <view class="pl-sub">{{v.prologue.sub}}</view>
      <view class="pl-title">{{v.prologue.title}}</view>
      <view class="pl-body">{{v.prologue.body}}</view>
      <view class="pl-turn" bindtap="closePrologue"><text class="pl-link">翻过此页 →</text></view>
    </view>

    <!-- 本旬之事 -->
    <view class="sect-panel" wx:if="{{v.events.length}}">
      <view class="h3">本旬之事 · 待你决断</view>
      <view class="sect-events">
        <view class="sect-ev {{item.urgent?'urgent':''}} {{item.ask?'ask':''}}" wx:for="{{v.events}}" wx:key="idx">
          <view class="sect-ev-type ev-{{item.evClass}}">{{item.type}}</view>
          <view class="h4">{{item.title}}</view>
          <view class="p"><text wx:for="{{item.descLines}}" wx:for-item="ln" wx:key="*this">{{ln}}\n</text></view>
          <view class="sect-quote" wx:if="{{item.quote}}">「{{item.quote}}」</view>
          <view class="sect-opt {{!o.ok?'disabled':''}}" wx:for="{{item.opts}}" wx:for-item="o" wx:key="oi" data-idx="{{item.idx}}" data-oi="{{o.oi}}" bindtap="pick" hover-class="sect-opt-hover">
            <image class="sect-opt-ico" src="{{o.ico}}" mode="aspectFit" aria-hidden="true" />
            <view class="ot">{{o.txt}}</view>
            <view class="req" wx:if="{{!o.ok}}">{{o.why}}</view>
          </view>
          <view class="sect-opt skip-opt" data-idx="{{item.idx}}" bindtap="skip" hover-class="sect-opt-hover">
            <image class="sect-opt-ico" src="/assets/icon/opt-skip.svg" mode="aspectFit" aria-hidden="true" />
            <view class="ot">搁置（占积压）</view>
          </view>
        </view>
      </view>
    </view>

    <!-- 主舞台底部：只留「山务」「山志」与「过此旬」三个入口 -->
    <view class="sect-foot">
      <button class="sect-btn {{v.moodOpen?'on':''}}" bindtap="toggleMood">山 务</button>
      <button class="sect-btn {{v.chronicleOpen?'on':''}}" bindtap="toggleChron">山 志</button>
      <button class="sect-btn primary" bindtap="settle">过 此 旬 →</button>
    </view>

    <!-- 营建/祭炼/赌局面板已并入「山务」抽屉内部（见下 .sect-drawer） -->

    <!-- 山志·原著脉络：fixed bottom sheet -->
    <view class="sect-sheet" wx:if="{{v.chronicleOpen}}">
      <view class="sect-sheet-mask" bindtap="toggleChron"></view>
      <view class="sect-sheet-body">
        <view class="sect-sheet-handle" bindtap="toggleChron"><view class="sect-sheet-bar"></view></view>
        <scroll-view scroll-y class="sect-sheet-scroll">
          <view class="h3">山 志 · 原 著 脉 络</view>
          <view class="sect-card-sub">自泥瓶巷到万山朝奉，脉络依《剑来》原著按时序排列；「册」指浙江文艺出版社实体书册目。</view>
          <view class="sect-chron">
            <view class="sect-chron-i" wx:for="{{v.chronicle}}" wx:key="t">
              <view class="sect-chron-t">{{item.t}}</view>
              <view class="sect-chron-d">{{item.d}}</view>
              <view class="sect-chron-q" wx:if="{{item.q}}">「{{item.q}}」</view>
              <view class="sect-chron-src">{{item.src}}</view>
            </view>
          </view>
          <button class="sect-btn ghost sm" bindtap="toggleChron">收 起 ↑</button>
        </scroll-view>
      </view>
    </view>

    <!-- 山务抽屉：fixed bottom sheet，盖主舞台，内部滚动；营建/祭炼/赌局子面板收进此处 -->
    <view class="sect-sheet" wx:if="{{v.moodOpen}}">
      <view class="sect-sheet-mask" bindtap="toggleMood"></view>
      <view class="sect-sheet-body">
        <view class="sect-sheet-handle" bindtap="toggleMood"><view class="sect-sheet-bar"></view></view>
        <scroll-view scroll-y class="sect-sheet-scroll">
        <view class="sect-drawer-bar">
          <view class="sect-drawer-title">山 务</view>
          <view class="sect-drawer-sub">本旬行动点 {{v.ap}} ／ 3　·　积压未理事 {{v.backlog}}</view>
          <view class="sect-btn ghost sm" bindtap="toggleMood">收 起 ↑</view>
        </view>

        <view class="sect-drawer-actions">
          <button class="sect-btn" data-ui="build" bindtap="ui">营 建</button>
          <button class="sect-btn" bindtap="recruit">寻 访 弟 子</button>
          <button class="sect-btn" data-ui="forge" bindtap="ui">祭 炼 飞 剑</button>
          <button class="sect-btn" bindtap="preach">讲 道</button>
          <button class="sect-btn" bindtap="trade">走 商</button>
          <button class="sect-btn" disabled="{{!v.actions.canBreak}}" bindtap="brk">{{v.actions.breakTxt}}</button>
          <button class="sect-btn" wx:if="{{v.actions.gambBtn}}" data-ui="gamble" bindtap="ui">赌 局</button>
        </view>

        <!-- 营建面板 -->
        <view wx:if="{{v.ui==='build'}}" class="sect-panel">
          <view class="h3">营 建（升一级耗 1 行动点）</view>
          <view class="sect-card-row" wx:for="{{v.buildings}}" wx:key="key">
            <view><view class="sect-card-name">{{item.name}} <text class="sect-lv">Lv.{{item.lv}}/{{item.max}}</text></view>
            <view class="sect-card-sub">{{item.sub}}</view></view>
            <button class="sect-btn sm" wx:if="{{!item.maxed}}" data-key="{{item.key}}" bindtap="build">{{item.costTxt}}</button>
            <text wx:else class="sect-lv">满</text>
          </view>
          <button class="sect-btn ghost sm" data-ui="main" bindtap="ui">返回</button>
        </view>

        <!-- 祭炼面板 -->
        <view wx:elif="{{v.ui==='forge'}}" class="sect-panel">
          <view class="h3">祭 炼 飞 剑（耗 灵10 银5，1 行动点）</view>
          <view class="sect-card-sub">剑庐等级越高，可祭炼柄数越多、越不易失剑。可「以道心护剑」降失败率。</view>
          <view wx:if="{{v.swords.length}}">
            <view class="sect-card-row" wx:for="{{v.swords}}" wx:key="name">
              <view><view class="sect-card-name">{{item.name}} <text class="sect-lv">阶{{item.tier}} · {{item.dao}}道</text></view>
              <view class="sect-words"><text class="sect-word" wx:for="{{item.words}}" wx:key="*this">{{w}}</text></view></view>
            </view>
          </view>
          <view wx:else class="sect-empty">尚无飞剑。于剑庐祭炼，可得剑胚与本命飞剑。</view>
          <button class="sect-btn sm" bindtap="forge">祭 炼 一 次</button>
          <button class="sect-btn ghost sm" data-ui="main" bindtap="ui">返回</button>
        </view>

        <!-- 赌局面板 -->
        <view wx:elif="{{v.ui==='gamble'}}" class="sect-panel">
          <view class="h3">倒悬山赌局（耗 1 行动点）</view>
          <view class="sect-card-sub">小赌怡情，大赌伤身。别院越高，逢凶化吉之机越盛。</view>
          <view class="sect-actions">
            <button class="sect-btn" bindtap="gambleSmall">小 赌（银10）</button>
            <button class="sect-btn" bindtap="gambleBig">孤 注（银25）</button>
            <button class="sect-btn ghost sm" data-ui="main" bindtap="ui">返回</button>
          </view>
        </view>

        <view class="sect-panel">
          <view class="h3">山 中 建 筑</view>
        <view class="sect-card-row" wx:for="{{v.buildings}}" wx:key="key">
          <view><view class="sect-card-name">{{item.name}} <text class="sect-lv">Lv.{{item.lv}}/{{item.max}}</text></view>
          <view class="sect-card-sub">{{item.sub}}</view></view>
        </view>
      </view>

      <view class="sect-panel">
        <view class="h3">门 下 弟 子（{{v.discSlots.used}}/{{v.discSlots.max}}）</view>
        <view wx:if="{{v.disciples.length}}">
          <view class="sect-card-row sect-disc" wx:for="{{v.disciples}}" wx:key="name">
            <image wx:if="{{item.hasArt}}" class="sect-portrait" src="/packageArt/assets/portraits/{{item.art}}.jpg" mode="aspectFill" lazy-load/>
            <view wx:else class="sect-portrait no-art">剑来</view>
            <view class="dinfo"><view class="sect-card-name">{{item.name}} <text class="sect-lv">{{item.realmName}}境 · {{item.dao}}道</text></view>
            <view class="sect-card-sub">修为 {{item.xiwei}} · 忠心 <text class="{{item.loyalCls}}">{{item.loyal}}</text></view></view>
          </view>
        </view>
        <view wx:else class="sect-empty">门下尚无弟子。可于事件中收徒，或主动寻访。</view>
      </view>

      <view class="sect-panel">
        <view class="h3">本 命 飞 剑</view>
        <view wx:if="{{v.swords.length}}">
          <view class="sect-card-row" wx:for="{{v.swords}}" wx:key="name">
            <view><view class="sect-card-name">{{item.name}} <text class="sect-lv">阶{{item.tier}} · {{item.dao}}道</text></view>
            <view class="sect-words"><text class="sect-word" wx:for="{{item.words}}" wx:for-item="w" wx:key="*this">{{w}}</text></view></view>
          </view>
        </view>
        <view wx:else class="sect-empty">尚无飞剑。于剑庐祭炼，可得剑胚与本命飞剑。</view>
      </view>

      <view class="sect-panel sect-daoqi">
        <view class="h3">因果 · 道契</view>
        <view class="dq-st">
          <text wx:for="{{v.daoqi.axes}}" wx:key="label">{{item.label}}：<text class="dq-b {{item.v>0?'pos':(item.v<0?'neg':'')}}">{{item.v>0?item.pos:(item.v<0?item.neg:'未定')}}</text>　</text>
        </view>
        <view class="dq-rel" wx:if="{{v.daoqi.rel.length}}">
          <text wx:for="{{v.daoqi.rel}}" wx:key="k" class="dq-n">{{item.k}} {{item.v>0?'+':''}}{{item.v}}　</text>
        </view>
        <view class="dq-rel" wx:else>尚未结下深缘</view>
      </view>

      <view class="sect-panel sect-figs">
        <view class="h3">人物志 · 已识 {{v.figures.met}} / {{v.figures.total}}</view>
        <view class="fig-bar"><view class="i" style="width:{{v.figures.pct}}%"></view></view>
        <view class="fig-grid">
          <view class="fig-card" wx:for="{{v.figures.list}}" wx:key="k">
            <image wx:if="{{item.hasArt}}" class="fig-portrait" src="/packageArt/assets/portraits/{{item.art}}.jpg" mode="aspectFill" lazy-load/>
            <view wx:else class="fig-portrait no-art">{{item.k}}</view>
            <view class="fig-n">{{item.k}}</view>
            <view class="fig-t">{{item.t}}</view>
            <view class="fig-f">{{item.f}}</view>
            <view class="fig-d">{{item.d}}</view>
            <view class="fig-q">「{{item.q}}」</view>
          </view>
        </view>
      </view>

      <view class="sect-panel">
        <view class="h3">山 中 纪 事</view>
        <view class="sect-log">
          <view class="lg {{item.cls}}" wx:for="{{v.log}}" wx:key="t">{{item.t}}</view>
        </view>
      </view>

      <view class="sect-back"><button class="sect-btn ghost" bindtap="back">回到卷首</button></view>
        </scroll-view>
      </view>
    </view>
  </block>

  <!-- ===================== 演出层：回合横幅 + 资源飘字（覆盖于主舞台，不拦截点击） ===================== -->
  <view class="sect-fx">
    <view class="sect-fx-banner {{item.cls}}" wx:for="{{v.fxBanners}}" wx:key="title">
      <view class="bt">{{item.title}}</view>
      <view class="bs" wx:if="{{item.sub}}">{{item.sub}}</view>
      <view class="bline"></view>
    </view>
    <view class="sect-fx-float {{item.cls}}" wx:for="{{v.fxFloats}}" wx:key="id">{{item.text}}</view>
  </view>
</view>
