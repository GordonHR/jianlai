/* 太平无事牌 · 八十面箴言匣（小程序端，与 PC 1:1） */
.wsp { padding:24rpx 26rpx 40rpx; background:#1c1610; border:1px solid #3a2f23;
       border-radius:20rpx; margin:20rpx 22rpx; box-sizing:border-box; }

/* 顶部栏已删除（用户 2026-09-03 撤掉"天 下 太 平"），仅一排按钮 + 右侧小计数 */
.wsp-bar { display:flex; align-items:center; justify-content:center; gap:24rpx;
           margin:14rpx 0 12rpx; position:relative; }
.wsp-bar .btn { padding:10rpx 30rpx; font-size:26rpx; border-radius:10rpx; letter-spacing:4rpx; }
.wsp-bar .wsp-draw { background:rgba(232,198,106,.18); border:2rpx solid rgba(232,198,106,.55);
                     color:#e8c66a; font-family:var(--kai); }
.wsp-bar-count { position:absolute; right:14rpx; top:50%; transform:translateY(-50%);
                 font-family:var(--kai); font-size:22rpx; color:#8a7e6c; letter-spacing:1rpx; }

.wsp-hint { font-size:23rpx; line-height:1.7; color:#9a8f7c; margin:0 0 18rpx; }

/* 木墙：3 列 + 2:3 比例（竖版高>宽） */
.wsp-wall { display:grid; grid-template-columns:repeat(3,1fr); gap:24rpx 18rpx; padding:0 4rpx; }
.wsp-card { position:relative; width:100%; aspect-ratio:2/3; perspective:900px; }
.wsp-inner { position:absolute; inset:0; transform-style:preserve-3d;
             transition:transform .52s cubic-bezier(.28,.8,.3,1); }
.wsp-card.on .wsp-inner { transform:rotateY(180deg); }
.wsp-face { position:absolute; inset:0; backface-visibility:hidden; border-radius:6rpx;
            border:2rpx solid #8a7455; }

/* 牌背 */
.wsp-wood { background:#c2ac86; overflow:hidden; }
.wsp-wood::after { content:''; position:absolute; inset:0; pointer-events:none;
                   background:repeating-linear-gradient(96deg, rgba(90,66,38,.055) 0 3rpx, transparent 3rpx 9rpx); }
.wsp-cord { position:absolute; top:0; left:50%; width:2rpx; height:26rpx; background:#7a6647; }
.wsp-hole { position:absolute; top:30rpx; left:50%; margin-left:-6rpx; width:12rpx; height:12rpx;
            border-radius:50%; background:#1c1610; }
.wsp-no { position:absolute; bottom:10rpx; right:14rpx; font-family:var(--kai); font-size:22rpx; color:#6f5c3e; }

/* 牌面：竖版下整张牌做底，mask 上下都渐隐 */
.wsp-words { background:#d9cbb0; transform:rotateY(180deg); transform-style:preserve-3d; overflow:hidden; }
.wsp-art { position:absolute; left:0; right:0; top:0; bottom:0; width:100%; height:100%;
           object-fit:cover; object-position:50% 22%; filter:blur(12rpx) saturate(.5) brightness(.78);
           opacity:.36;
           -webkit-mask-image:linear-gradient(to bottom, rgba(0,0,0,0) 0%, rgba(0,0,0,.95) 28%, rgba(0,0,0,.95) 74%, rgba(0,0,0,0) 100%);
                   mask-image:linear-gradient(to bottom, rgba(0,0,0,0) 0%, rgba(0,0,0,.95) 28%, rgba(0,0,0,.95) 74%, rgba(0,0,0,0) 100%); }
.wsp-art.wsp-pattern { filter:none; opacity:1;
            background:
              radial-gradient(circle at 84% 14%, rgba(180,69,60,.10) 0%, transparent 28%),
              radial-gradient(circle at 18% 86%, rgba(232,198,106,.10) 0%, transparent 30%),
              repeating-linear-gradient(125deg, rgba(90,66,38,.06) 0 2rpx, transparent 2rpx 14rpx),
              linear-gradient(170deg, #d9cbb0 0%, #c2ac86 100%); }
.wsp-in2 { position:absolute; inset:0; transform-style:preserve-3d;
           transition:transform .5s cubic-bezier(.28,.8,.3,1); }
.wsp-card.s2.on2 .wsp-in2 { transform:rotateX(180deg); }
.wsp-w1, .wsp-w2 { position:absolute; inset:0; backface-visibility:hidden; }
.wsp-w2 { transform:rotateX(180deg); }
/* 多卡片页面不展示文字（用户 2026-09-03：只在弹框内展示），卡片仅留立绘+编号 */

.wsp-seal { margin:30rpx auto 6rpx; text-align:center; opacity:0; transform:scale(.94);
            transition:opacity .6s ease, transform .6s ease; pointer-events:none; }
.wsp-seal.on { opacity:1; transform:scale(1); }
.wsp-seal text { display:inline-block; border:4rpx solid rgba(180,69,60,.75); color:#c0604f;
                 font-family:var(--kai); font-size:32rpx; letter-spacing:16rpx;
                 padding:16rpx 32rpx 16rpx 48rpx; border-radius:6rpx; }
.wsp-acts { text-align:center; margin-top:32rpx; }
.wsp-acts .btn { margin:0 12rpx; }

/* 放大详情层：2:3 竖版 + 翻转开合 + 模糊立绘底 + 四周金光 + 斜向光影 */
.wsp-dt { position:fixed; inset:0; z-index:60; display:flex; align-items:center; justify-content:center; }
.wsp-dt-scrim { position:absolute; inset:0; background:rgba(10,8,6,.74); }
.wsp-dt-card { position:relative; width:74%; max-width:620rpx; aspect-ratio:2/3;
               border-radius:18rpx; overflow:hidden;
               background:linear-gradient(168deg, #ecdcbe 0%, #d9cbb0 58%, #c2ac86 100%);
               box-shadow:0 26rpx 70rpx rgba(0,0,0,.62),
                          inset 0 0 26rpx 6rpx rgba(255,222,150,.55);
               animation:wspFlip .42s cubic-bezier(.22,.82,.3,1) both; }
@keyframes wspFlip {
  from { opacity:0; transform:perspective(1400rpx) rotateY(-82deg) translateY(16rpx); }
  60%  { opacity:1; }
  to   { opacity:1; transform:perspective(1400rpx) rotateY(0deg) translateY(0); }
}
/* 四周不规则金光：更亮、四角偏移不对称 */
.wsp-dt-glow { position:absolute; inset:0; pointer-events:none; z-index:3;
               background:
                 radial-gradient(130% 95% at 84% -8%,  rgba(255,238,182,.80) 0%, rgba(255,232,160,.22) 30%, rgba(255,232,160,0) 58%),
                 radial-gradient(120% 95% at 10% 116%, rgba(255,224,140,.70) 0%, rgba(255,220,130,.18) 32%, rgba(255,220,130,0) 60%),
                 radial-gradient(85% 80% at -14% 58%,   rgba(232,200,110,.62) 0%, rgba(232,198,106,.16) 40%, rgba(232,198,106,0) 68%),
                 radial-gradient(82% 78% at 114% 44%,   rgba(232,200,110,.58) 0%, rgba(232,198,106,.14) 40%, rgba(232,198,106,0) 66%),
                 radial-gradient(60% 42% at 28% 20%,    rgba(255,232,168,.24) 0%, rgba(255,232,168,0) 64%);
               mix-blend-mode:screen; }
/* 斜向光影：一道斜光带，开合时横扫一次 */
.wsp-dt-sheen { position:absolute; inset:0; pointer-events:none; z-index:1;
                background:linear-gradient(118deg,
                  rgba(255,255,255,0) 38%, rgba(255,246,214,.16) 47%,
                  rgba(255,255,255,.34) 50%, rgba(255,246,214,.16) 53%,
                  rgba(255,255,255,0) 62%);
                mix-blend-mode:screen;
                animation:wspSheen 1.1s ease-out both; }
@keyframes wspSheen {
  0%   { transform:translateX(-58%); opacity:0; }
  25%  { opacity:1; }
  100% { transform:translateX(58%); opacity:0; }
}
/* 模糊立绘做底（z0）：有立绘时压暗 + 适度模糊，让竖排文字浮出清晰 */
.wsp-dt-bg { position:absolute; inset:0; width:100%; height:100%; object-fit:cover;
             object-position:50% 22%; filter:blur(11rpx) saturate(.55) brightness(.52);
             opacity:.72; transform:scale(1.08); z-index:0; }
/* 无立绘做底（z0） */
.wsp-dt-pattern { position:absolute; inset:0; z-index:0;
                  background:
                    radial-gradient(circle at 82% 12%, rgba(180,69,60,.14) 0%, transparent 34%),
                    radial-gradient(circle at 14% 84%, rgba(232,198,106,.18) 0%, transparent 38%),
                    radial-gradient(circle at 50% 50%, rgba(255,228,170,.08) 0%, transparent 60%),
                    repeating-linear-gradient(125deg, rgba(90,66,38,.07) 0 2rpx, transparent 2rpx 16rpx),
                    linear-gradient(165deg, #e6d7b6 0%, #d9cbb0 60%, #c2ac86 100%); }
/* 面板透明，立绘透出；牌文顶部对齐 */
.wsp-dt-panel { position:relative; z-index:2; width:100%; height:100%; padding:64rpx 36rpx 40rpx;
                display:flex; flex-direction:column; align-items:center; justify-content:flex-start;
                background:none;
                border:2rpx solid rgba(232,198,106,.5); box-sizing:border-box; }
.wsp-dt-no { position:absolute; top:20rpx; right:28rpx; font-family:var(--kai); font-size:24rpx; color:#6f5c3e;
             text-shadow:0 2rpx 4rpx rgba(255,245,220,.6); }
.wsp-dt-words { flex:1; display:flex; flex-direction:row; align-items:flex-start; justify-content:center;
                width:100%; padding:0 6rpx; min-height:0; }
/* 牌文：JS 按"每列 12 字"切成多段竖排列（用户 2026-09-04 明示：固定每列 12 字、多折行、从右往左）。
   .wsp-dt-txt 用 flex row-reverse 让切出来的列从右往左排；
   注意：.wsp-dt-txt 不能写 writing-mode，否则 row-reverse 会被旋转成上下堆叠（这是 PC 端第 10 轮的 bug，已撤回）；
   writing-mode 只给 .wsp-dt-col。 */
.wsp-dt-txt { display:flex; flex-direction:row-reverse; align-items:flex-start; justify-content:center;
              font-family:'STXingkai','KaiTi','STKaiti','STSongti-SC',serif; font-size:44rpx; line-height:1.55; letter-spacing:3rpx; color:#2c2417;
              gap:12rpx; max-height:100%; min-height:0;
              text-shadow:0 1rpx 4rpx rgba(255,245,220,.92), 0 0 8rpx rgba(255,238,200,.78),
                          0 2rpx 6rpx rgba(0,0,0,.42); }
.wsp-dt-col { writing-mode:vertical-rl; text-orientation:upright; white-space:nowrap; display:inline-block; }
/* 说的人：文字左侧用竖线分隔的一列名字（竖排） */
.wsp-dt-who { writing-mode:vertical-rl; text-orientation:upright;
              font-family:'STXingkai','KaiTi','STKaiti','STSongti-SC',serif; font-size:26rpx; line-height:1.7; letter-spacing:4rpx; color:#7a5a2e;
              border-left:3rpx solid rgba(180,69,60,.6); padding-left:10rpx; margin-right:16rpx;
              align-self:flex-start; text-shadow:0 1rpx 4rpx rgba(255,245,220,.8); }
/* 旧 .wsp-dt-again / .wsp-dt-x 样式撤除，保留空声明以防 CSS 残留误用 */