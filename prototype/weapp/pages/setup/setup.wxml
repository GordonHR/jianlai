<view class="setup">
  <view class="h1">剑来 · 择主</view>
  <view class="hint">【{{metaTitle}}】{{tip}}　点击卡面选中/移除。</view>

  <view class="filterbar">
    <view wx:for="{{facs}}" wx:key="*this" class="fbtn {{filter===item?'on':''}}" bindtap="setFilter" data-f="{{item}}">{{item}}</view>
    <input class="fsearch" placeholder="搜人物" value="{{q}}" bindinput="onSearch" confirm-type="search"/>
  </view>

  <scroll-view scroll-y class="grid-scroll">
    <view class="grid">
      <view wx:for="{{view}}" wx:key="key" class="char {{item.selected?'sel':''}}" style="border-color:{{item.col}}" bindtap="toggleSelect" data-key="{{item.key}}">
        <view class="cw" style="background:{{item.col}}">
          <text wx:if="{{!item.art}}" class="ph-initial">剑来</text>
          <image wx:else src="{{item.art}}" class="charimg" mode="aspectFill"/>
          <view class="name-over">{{item.name}}</view>
          <view class="badge badge-hp">气血 {{item.hp}}</view>
          <view class="badge badge-realm">{{item.realm}}</view>
          <view class="fac-over" style="color:{{item.col}}">{{item.faction}}</view>
          <view wx:if="{{item.selected}}" class="selmark">✓</view>
        </view>
        <view class="charinfo">
          <view class="csk">{{item.sk1}}{{item.sk1 && item.sk2 ? ' · ' : ''}}{{item.sk2}}</view>
          <view class="cno">气血 {{item.hp}} · 天赋·{{item.talent}}</view>
        </view>
      </view>
      <view wx:if="{{view.length===0}}" class="empty">此间无人。</view>
    </view>
  </scroll-view>

  <view class="roster">
    <text class="rtitle">已 选</text>
    <view wx:for="{{list}}" wx:key="key" wx:if="{{item.selected}}" class="rslot" bindtap="removeSel" data-key="{{item.key}}">
      <text wx:if="{{!item.art}}" class="rph" style="background:{{item.col}}">剑来</text>
      <image wx:else src="{{item.art}}" class="rimg" mode="aspectFill"/>
      <text class="rname">{{item.name}}</text>
      <text class="rx">×</text>
    </view>
    <view wx:for="{{maxPick}}" wx:key="*this" wx:if="{{index>=sel.length}}" class="rslot empty">＋</view>
    <view class="spacer"></view>
    <view class="btn ghost" bindtap="randomPick">随机择主</view>
    <view wx:if="{{mode==='ai'}}" class="ai-count">
      对手
      <text class="stepper-n {{aiCount===1?'on':''}}" bindtap="changeAi" data-n="1">1</text>
      <text class="stepper-n {{aiCount===2?'on':''}}" bindtap="changeAi" data-n="2">2</text>
      <text class="stepper-n {{aiCount===3?'on':''}}" bindtap="changeAi" data-n="3">3</text>
      名
    </view>
    <view class="btn ghost" bindtap="back">返回</view>
    <view class="btn primary {{canStart?'':'disabled'}}" bindtap="start">{{mode==='siege'?'登城迎敌':(mode==='boss'?'起兵讨伐':'开始对战')}}</view>
  </view>

  <!-- 随机择主：中转过场（暗幕 → 剑光 → 择主大字 → 角色名 → 落印 → 进场） -->
  <view wx:if="{{pickFxOn}}" class="pick-fx">
    <view class="pf-mask"></view>
    <view class="pf-swordlight"></view>
    <view class="pf-core">
      <view class="pf-title">择 主</view>
      <view class="pf-names">
        <view wx:for="{{pickNames}}" wx:key="*this" class="pf-name" style="animation-delay:{{index*160+420}}ms">{{item}}</view>
      </view>
      <view wx:if="{{mode==='ai'}}" class="pf-sub" style="animation-delay:{{pickNames.length*160+560}}ms">天意撮合…</view>
      <view class="pf-seal">剑来</view>
    </view>
  </view>
</view>
