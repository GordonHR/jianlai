<view class="title-screen">
  <!-- 开场 v3：少年 → 拉开全局 → 轻推回少年 → 书法 -->
  <view class="op" wx:if="{{opShow}}" catchtouchmove="noop">
    <!-- 单张大图：小镇+镇外+背剑少年，运镜全在图上 -->
    <view class="op-stage {{phase}}">
      <image class="op-bgimg" src="/assets/opening/bg-ink.jpg" mode="aspectFill"/>
    </view>

    <view class="op-vig"></view>

    <!-- 光影层：镇门呼吸 / 山道光线 / 体积光 / 流雾 -->
    <view class="op-light">
      <view class="op-gate-glow"></view>
      <view class="op-path-ray"></view>
      <view class="op-ray a"></view>
      <view class="op-ray b"></view>
      <view class="op-ray c"></view>
      <view class="op-fog f1"></view>
      <view class="op-fog f2"></view>
      <view class="op-fog f3"></view>
    </view>

    <!-- 聚焦少年后：衣摆 / 剑身微光 / 足下雾（无全屏剑光） -->
    <view class="op-youthfx {{phase}}">
      <view class="yf-robe r1"></view>
      <view class="yf-robe r2"></view>
      <view class="yf-robe r3"></view>
      <view class="yf-mist m1"></view>
      <view class="yf-mist m2"></view>
      <view class="yf-mist m3"></view>
    </view>

    <!-- 拉开时极淡暖光，不是斩击 -->
    <view class="op-breathe {{phase}}"></view>

    <view class="op-title {{phase}}">
      <image class="op-logo-img" src="/assets/opening/calligraphy.png" mode="aspectFit"/>
      <image class="op-sc" src="/assets/opening/seal-sc.png" mode="aspectFit"/>
    </view>

    <view class="op-finbar" wx:if="{{enterOn}}">
      <view class="op-btn on" catchtap="opEnter">开始问剑</view>
    </view>
  </view>

  <image class="ts-bg" src="/assets/bg/cover.jpg" mode="aspectFill" />
  <view class="ts-scrim"></view>
  <view class="ts-mark">剑来</view>
  <view class="ts-rule"></view>
  <view class="ts-desc">江湖没什么好的，也就酒还行</view>

  <view class="ts-group">
    <view class="ts-group-title">对 战</view>
    <view class="mode-grid">
      <view class="ts-mode" bindtap="goMode" data-mode="ai">
        <view class="ts-mode-head">
          <text class="h3">仗剑独行</text>
          <image class="mode-ico" src="/assets/icon/mode-sword.svg" mode="aspectFit"/>
        </view>
        <text class="p">你执一人，与 1–3 名由天意撮合的对手酣战。对手自行出牌、应招、讲道理。</text>
        <text class="md-meta">选 1 人 · 对手 1–3 名</text>
      </view>
      <view class="ts-mode" bindtap="goMode" data-mode="hot">
        <view class="ts-mode-head">
          <text class="h3">群雄论剑</text>
          <image class="mode-ico" src="/assets/icon/mode-duel.svg" mode="aspectFit"/>
        </view>
        <text class="p">2–5 人共坐一席、轮流传机，彼此斗智。适合现场对决。</text>
        <text class="md-meta">选 2–5 人 · 全为手动</text>
      </view>
      <view class="ts-mode" bindtap="goMode" data-mode="siege">
        <view class="ts-mode-head">
          <text class="h3">剑气长城</text>
          <image class="mode-ico" src="/assets/icon/mode-wall.svg" mode="aspectFit"/>
        </view>
        <text class="p">蛮荒天下分五波叩关。每波退敌可回气补牌，看你能守到第几波。</text>
        <text class="md-meta">守方 1–2 人 · 共 5 波</text>
      </view>
      <view class="ts-mode" bindtap="goMode" data-mode="boss">
        <view class="ts-mode-head">
          <text class="h3">天下共伐</text>
          <image class="mode-ico" src="/assets/icon/mode-boss.svg" mode="aspectFit"/>
        </view>
        <text class="p">2–3 人联手围攻一名气血 ×2 的巨寇。第 4 轮起巨寇威压渐盛。</text>
        <text class="md-meta">讨伐方 2–3 人 · 1 名巨寇</text>
      </view>
    </view>
  </view>

  <view class="ts-group">
    <view class="ts-group-title">问 心</view>
    <view class="mode-grid">
      <view class="ts-mode" bindtap="goAskLake">
        <view class="ts-mode-head">
          <text class="h3">书简湖问心局</text>
          <image class="mode-ico" src="/assets/icon/mode-bamboo.svg" mode="aspectFit"/>
        </view>
        <text class="p">不拼剑气，只问本心。替陈平安在书简湖的恩怨善恶中做出抉择，看最终能否问心无愧。</text>
        <text class="md-meta">单人叙事 · 多结局</text>
      </view>
      <view class="ts-mode" bindtap="goLongque">
        <view class="ts-mode-head">
          <text class="h3">笼中雀</text>
          <image class="mode-ico" src="/assets/icon/mode-longque.svg" mode="aspectFit"/>
        </view>
        <text class="p">骊珠洞天像一只笼子。你是泥瓶巷担水的少年陈平安——听先生讲学、护巷口兄弟、断桥练拳，直到心里那只雀抬起头。</text>
        <text class="md-meta">单人叙事 · 童年线 · 15 结局</text>
      </view>
    </view>
  </view>

  <view class="ts-group">
    <view class="ts-group-title">经 营</view>
    <view class="mode-grid">
      <view class="ts-mode" bindtap="goSect">
        <view class="ts-mode-head">
          <text class="h3">落魄山</text>
          <image class="mode-ico" src="/assets/icon/mode-mountain.svg" mode="aspectFit"/>
        </view>
        <text class="p">以「旬」为节奏经营门派：收徒、建观、祭炼飞剑，于骊珠降格与蛮荒叩关中求得建宗大典立世。</text>
        <text class="md-meta">单人养成 · 多结局</text>
      </view>
      <view class="ts-mode" bindtap="goShenci">
        <view class="ts-mode-head">
          <text class="h3">山水祠</text>
          <image class="mode-ico" src="/assets/icon/mode-shrine.svg" mode="aspectFit"/>
        </view>
        <text class="p">你是一位末流山水神明，辖一方水土。不能下山，不能出手，只能应，或不应——香火养你，也绑住你。</text>
        <text class="md-meta">单人养成 · 四十八旬 · 七结局</text>
      </view>
      <view class="ts-mode" bindtap="goBaofu">
        <view class="ts-mode-head">
          <text class="h3">包袱斋</text>
          <image class="mode-ico" src="/assets/icon/bf-shirou.svg" mode="aspectFit"/>
        </view>
        <text class="p">掌柜石柔坐镇的小铺子：和气斋赊账、拣漏掌眼、藏书阁翻书、锦囊行囊。雪花钱与道行，都在此处流转。</text>
        <text class="md-meta">经营 · 雪花钱</text>
      </view>
    </view>
  </view>

  <view class="ts-group">
    <view class="ts-group-title">阅 览</view>
    <view class="mode-grid">
      <view class="ts-mode" bindtap="goCodex">
        <view class="ts-mode-head">
          <text class="h3">人 物 志</text>
          <image class="mode-ico" src="/assets/icon/mode-scroll.svg" mode="aspectFit"/>
        </view>
        <text class="p">不涉战局，只翻阅群英：立绘、阵营、境界、技能与原著简报。</text>
        <text class="md-meta">全角色</text>
      </view>
      <view class="ts-mode" bindtap="goTales">
        <view class="ts-mode-head">
          <text class="h3">戏 里 戏 外</text>
          <image class="mode-ico" src="/assets/icon/mode-tales.svg" mode="aspectFit"/>
        </view>
        <text class="p">原著里的闲笔与回响：杨晃夫妇、齐静春称圣、阿良、崔瀺、宁姚……取《剑来》本意，不杜撰。</text>
        <text class="md-meta">原著小记</text>
      </view>
      <view class="ts-mode" bindtap="goWsp">
        <view class="ts-mode-head">
          <text class="h3">无 事 牌</text>
          <image class="mode-ico" src="/assets/icon/mode-wsp.svg" mode="aspectFit"/>
        </view>
        <text class="p">剑气长城酒铺一面木墙，挂满木牌。出城杀妖前留一句话，当作最后的声音，也收录书中人物的对白与箴言。点牌即放大翻开，有对应人物者以模糊立绘做底。</text>
        <text class="md-meta">八十面 · 箴言匣</text>
      </view>
      <view class="ts-mode" bindtap="goFulu">
        <view class="ts-mode-head">
          <text class="h3">符 箓 图 鉴</text>
          <image class="mode-ico" src="/assets/icon/mode-fulu.svg" mode="aspectFit"/>
        </view>
        <text class="p">不涉战局，只翻阅符箓：缩地、破障、镇妖、求雨、雷符……名、功效、来历与出处皆依《剑来》原著，并附据古法符箓体例绘制的云篆图样（仅 PC 端可见）。</text>
        <text class="md-meta">原著符箓</text>
      </view>
      <view class="ts-mode" bindtap="goProfile">
        <view class="ts-mode-head">
          <text class="h3">行 者 录</text>
          <image class="mode-ico" src="/assets/icon/mode-scroll.svg" mode="aspectFit"/>
        </view>
        <text class="p">择定剑修 / 练气士 / 武夫三途，照《剑来》原著境界修行；跨模块累积道行、破境、论功，一册录尽行走江湖的痕迹。</text>
        <text class="md-meta">境界 · 道行</text>
      </view>
      <view class="ts-mode" bindtap="goMap">
        <view class="ts-mode-head">
          <text class="h3">天 下 舆 图</text>
          <image class="mode-ico" src="/assets/icon/mode-mountain.svg" mode="aspectFit"/>
        </view>
        <text class="p">浩然天下五方九洲，东宝瓶洲、中土神州、北俱芦洲……点洲下钻，阅其要地、势力、航路；骊珠洞天另设详图。严守原著，不臆造。</text>
        <text class="md-meta">世界地理 · 考据</text>
      </view>
    </view>
  </view>

  <view class="ts-foot">点击任一入口即启程</view>
</view>
