.title-screen { position:relative; min-height:100vh; padding: 150rpx 36rpx 80rpx; }
.ts-bg { position:absolute; top:0; left:0; width:100%; height:100%; z-index:0; }
.ts-scrim { position:absolute; top:0; left:0; width:100%; height:100%; z-index:1;
  background:linear-gradient(160deg, rgba(10,8,14,.80), rgba(16,12,22,.74) 50%, rgba(8,6,12,.92)); }
.ts-mark, .ts-rule, .ts-sub, .ts-desc, .ts-group, .ts-foot { position:relative; z-index:2; }
.ts-mark {
  font-family: "STXingkai","华文行楷","KaiTi","楷体",serif;
  font-size: 140rpx; text-align: center; color: #e8c66a;
  text-shadow: 0 0 30rpx rgba(232,198,106,.4);
}
.ts-rule { width: 200rpx; height: 3rpx; margin: 10rpx auto 18rpx; background: linear-gradient(90deg,transparent,#e8c66a,transparent); }
.ts-desc { text-align: center; font-size: 26rpx; letter-spacing: 3rpx; color: #c9b98f; margin: 18rpx 0 8rpx; line-height: 1.6; }
.ts-group { margin-top: 56rpx; }
.ts-group-title { font-size: 30rpx; color: #e8c66a; border-left: 6rpx solid #e8c66a; padding-left: 16rpx; margin-bottom: 22rpx; }
.mode-grid { display: flex; flex-wrap: wrap; gap: 22rpx; }
.ts-mode {
  width: calc(50% - 11rpx); background: rgba(255,255,255,.04);
  border: 1rpx solid rgba(232,198,106,.22); border-radius: 16rpx;
  padding: 26rpx 24rpx 30rpx; position: relative; display: flex; flex-direction: column;
}
.ts-mode-head { display: flex; justify-content: space-between; align-items: center; gap: 14rpx; margin-bottom: 14rpx; }
.mode-ico { width: 52rpx; height: 52rpx; opacity: .92; flex: 0 0 auto; }
.h3 { font-size: 34rpx; color: #f3ecdc; font-weight: 600; }
.p { font-size: 23rpx; color: #b6ad9c; line-height: 1.6; flex: 1; }
.md-meta { font-size: 21rpx; color: #7d756a; margin-top: 16rpx; }
.ts-foot { text-align: center; color: #6f675c; font-size: 24rpx; margin-top: 60rpx; }

/* ========== 开场：单图电影运镜 ========== */
.op {
  position: fixed; left:0; top:0; right:0; bottom:0; z-index: 999;
  overflow: hidden; background: #0c0a08;
}
/* 新图：人物约 32%/78%，镇门约 52%/62%，长城约 40%/38% */
.op-stage {
  position:absolute; inset:0;
  transform-origin: 50% 50%;
  background:#0c0a08;
  overflow:hidden;
  transform: translate(22%, -36%) scale(1.3);
  filter: brightness(.9) saturate(.98);
}
.op-bgimg { position:absolute; left:0; top:0; width:100%; height:100%; display:block; }
.op-stage.camIn {
  transform: translate(22%, -36%) scale(1.3);
  filter: brightness(.9) saturate(.98);
}
.op-stage.camOut { animation: filmOut 2.8s cubic-bezier(.42,.08,.25,1) both; }
@keyframes filmOut {
  0% { transform: translate(22%, -36%) scale(1.3); filter: brightness(.9) saturate(.98); }
  55% { transform: translate(4%, 2%) scale(1.08); filter: brightness(.98) saturate(1.02); }
  100% { transform: translate(0%, 0%) scale(1.03); filter: brightness(1.02) saturate(1.04); }
}
.op-stage.camHold {
  transform: translate(0%, 0%) scale(1.03);
  filter: brightness(1.02) saturate(1.04);
}
.op-stage.camPush { animation: filmPush 2.1s cubic-bezier(.42,.08,.25,1) both; }
@keyframes filmPush {
  0% { transform: translate(0%, 0%) scale(1.03); filter: brightness(1.02) saturate(1.04); }
  100% { transform: translate(20%, -32%) scale(1.22); filter: brightness(.94) saturate(1); }
}
.op-stage.youthFx {
  transform: translate(20%, -32%) scale(1.24);
  filter: brightness(.96) saturate(1.02);
  transition: transform .9s cubic-bezier(.4,.1,.3,1), filter .9s ease;
}
.op-stage.title, .op-stage.done {
  transform: translate(20%, -34%) scale(1.28);
  filter: brightness(.52) saturate(.88);
  transition: transform 1s cubic-bezier(.4,.1,.3,1), filter 1s ease;
}

/* 光影 */
.op-light { position:absolute; inset:0; z-index:6; pointer-events:none; overflow:hidden; }
.op-gate-glow {
  position:absolute; left:42%; top:54%;
  width:40%; height:22%;
  background: radial-gradient(ellipse at center,
    rgba(232,198,106,.34) 0%, rgba(232,198,106,.1) 40%, transparent 70%);
  filter: blur(20rpx); opacity:.5;
  animation: gateBreath 3.4s ease-in-out infinite;
}
@keyframes gateBreath {
  0%,100% { opacity:.4; transform: scale(1); }
  50% { opacity:.8; transform: scale(1.06); }
}
.op-path-ray {
  position:absolute; left:34%; top:64%;
  width:32%; height:2.5%;
  background: linear-gradient(90deg, rgba(232,198,106,.3), rgba(243,224,160,.12) 60%, transparent);
  filter: blur(6rpx); transform: rotate(32deg); transform-origin: left center;
  opacity:0; animation: raySweep 4.8s ease-in-out infinite;
}
@keyframes raySweep {
  0%,100% { opacity:0; transform: rotate(32deg) scaleX(.6); }
  35% { opacity:.65; transform: rotate(32deg) scaleX(1.05); }
  70% { opacity:0; }
}
.op-ray {
  position:absolute; top:-8%; width:7%; height:55%;
  background: linear-gradient(180deg, rgba(243,224,160,.07), transparent);
  filter: blur(14rpx); transform: rotate(10deg); opacity:0;
}
.op-ray.a { left:28%; animation: rayDrift 5.8s ease-in-out infinite; }
.op-ray.b { left:50%; animation: rayDrift 6.8s 1.1s ease-in-out infinite; width:5%; }
@keyframes rayDrift {
  0%,100% { opacity:0; transform: rotate(10deg) translateY(0); }
  40% { opacity:.45; transform: rotate(8deg) translateY(16rpx); }
  70% { opacity:0; }
}
.op-fog {
  position:absolute; left:-20%; right:-20%; height:16%;
  background: linear-gradient(90deg, transparent, rgba(200,190,170,.07) 30%, rgba(220,210,190,.09) 50%, rgba(200,190,170,.07) 70%, transparent);
  filter: blur(16rpx); opacity:.45;
}
.op-fog.f1 { top:40%; animation: fogMove 14s linear infinite; }
.op-fog.f2 { top:58%; animation: fogMove 18s -5s linear infinite; opacity:.3; }
@keyframes fogMove {
  0% { transform: translateX(-8%); }
  50% { transform: translateX(8%); }
  100% { transform: translateX(-8%); }
}

.op-vig {
  position:absolute; inset:0; z-index:10; pointer-events:none;
  background:
    radial-gradient(ellipse 72% 58% at 50% 48%, transparent 30%, rgba(12,10,8,.4) 72%, rgba(12,10,8,.78) 100%),
    linear-gradient(180deg, rgba(12,10,8,.28), transparent 20%, transparent 74%, rgba(12,10,8,.72));
}

/* 呼吸暖光 */
.op-breathe {
  position:absolute; inset:0; z-index:7; pointer-events:none; opacity:0;
  background: radial-gradient(ellipse 50% 36% at 52% 60%, rgba(232,198,106,.12), transparent 70%);
}
.op-breathe.camOut { animation: breatheIn 2s ease-out both; }
.op-breathe.camHold { opacity:.35; }
.op-breathe.camPush, .op-breathe.youthFx { opacity:.2; }
.op-breathe.title, .op-breathe.done { opacity:0; transition: opacity .8s ease; }
@keyframes breatheIn { 0%{opacity:0} 40%{opacity:.8} 100%{opacity:.35} }

/* 少年动效：衣摆 + 足下雾，对准 32%/78% */
.op-youthfx {
  position:absolute; inset:0; z-index:8; pointer-events:none; opacity:0;
}
.op-youthfx.camPush { opacity:.35; }
.op-youthfx.youthFx { opacity:1; }
.op-youthfx.title, .op-youthfx.done { opacity:.4; transition: opacity .8s ease; }

.yf-robe {
  position:absolute; left:32%; top:78%;
  width:38rpx; height:26rpx; margin-left:-6rpx;
  background: linear-gradient(180deg, rgba(18,14,10,.4), rgba(18,14,10,0));
  border-radius: 0 0 42% 42%; opacity:0; filter: blur(2rpx);
}
.yf-robe.r2 { margin-left:8rpx; width:30rpx; height:22rpx; top:79%; }
.yf-robe.r3 { margin-left:-18rpx; width:28rpx; height:20rpx; top:79.5%; }
.op-youthfx.youthFx .yf-robe.r1 { animation: robe1 1.7s ease-in-out infinite; }
.op-youthfx.youthFx .yf-robe.r2 { animation: robe2 2s .12s ease-in-out infinite; }
.op-youthfx.youthFx .yf-robe.r3 { animation: robe3 2.2s .28s ease-in-out infinite; }
@keyframes robe1 {
  0%,100% { opacity:.08; transform: translate(0,0) skewX(0) scaleX(1); }
  50% { opacity:.32; transform: translate(-8rpx,4rpx) skewX(-12deg) scaleX(1.14); }
}
@keyframes robe2 {
  0%,100% { opacity:.06; transform: translate(0,0) skewX(0); }
  50% { opacity:.28; transform: translate(7rpx,3rpx) skewX(10deg) scaleX(1.1); }
}
@keyframes robe3 {
  0%,100% { opacity:.05; transform: translate(0,0) rotate(0); }
  50% { opacity:.24; transform: translate(-5rpx,4rpx) rotate(-6deg); }
}
.yf-mist {
  position:absolute; left:32%; top:82%;
  width:52rpx; height:14rpx; margin-left:-26rpx;
  background: radial-gradient(ellipse at center, rgba(220,210,190,.2), transparent 70%);
  filter: blur(6rpx); opacity:0; border-radius:50%;
}
.yf-mist.m2 { width:36rpx; margin-left:-2rpx; top:83%; }
.yf-mist.m3 { width:42rpx; margin-left:-36rpx; top:82.5%; }
.op-youthfx.youthFx .yf-mist.m1 { animation: mist1 2.5s ease-in-out infinite; }
.op-youthfx.youthFx .yf-mist.m2 { animation: mist2 2.9s .35s ease-in-out infinite; }
.op-youthfx.youthFx .yf-mist.m3 { animation: mist3 2.7s .7s ease-in-out infinite; }
@keyframes mist1 {
  0%,100% { opacity:0; transform: translate(0,0) scale(1); }
  40% { opacity:.4; transform: translate(-6rpx,-10rpx) scale(1.12); }
}
@keyframes mist2 {
  0%,100% { opacity:0; transform: translate(0,0) scale(1); }
  40% { opacity:.28; transform: translate(8rpx,-8rpx) scale(1.08); }
}
@keyframes mist3 {
  0%,100% { opacity:0; transform: translate(0,0); }
  40% { opacity:.24; transform: translate(-4rpx,-12rpx); }
}

/* 落款 */
.op-title {
  position:absolute; inset:0; z-index:20;
  display:flex; align-items:center; justify-content:center;
  pointer-events:none; opacity:0;
}
.op-logo-img {
  width: 460rpx; height: 640rpx;
  transform: translateY(-6vh);
  filter: blur(20rpx); opacity:.25;
  transition: filter .7s cubic-bezier(.2,.7,.3,1), opacity .7s ease;
}
.op-sc {
  position:absolute; left:13%; bottom:30%;
  width:68rpx; height:68rpx;
  opacity:0; transform: scale(1.6) rotate(-18deg); filter: blur(5rpx);
}
.op-title.title, .op-title.done { opacity:1; animation: titleFade .65s ease-out both; }
.op-title.title .op-logo-img, .op-title.done .op-logo-img {
  filter: blur(0) drop-shadow(0 0 40rpx rgba(232,198,106,.4)) drop-shadow(0 8rpx 20rpx rgba(0,0,0,.55));
  opacity:1;
}
.op-title.title .op-sc, .op-title.done .op-sc {
  opacity:1; transform: scale(1) rotate(-8deg); filter: blur(0);
  animation: sealIn .3s .2s cubic-bezier(.2,1.5,.35,1) both;
}
@keyframes titleFade { from{opacity:0} to{opacity:1} }
@keyframes sealIn {
  0% { opacity:0; transform: scale(1.8) rotate(-20deg); filter: blur(5rpx); }
  65% { opacity:1; transform: scale(.95) rotate(-5deg); filter: blur(0); }
  100% { opacity:1; transform: scale(1) rotate(-8deg); filter: blur(0); }
}

.op-finbar { position:absolute; inset:0; z-index:40; pointer-events:none; }
.op-btn {
  position:absolute; left:50%;
  bottom: calc(140rpx + env(safe-area-inset-bottom, 0px));
  margin-left: -150rpx;
  width: 300rpx; height: 88rpx; line-height: 88rpx;
  text-align: center;
  border: 2rpx solid rgba(232,198,106,.85);
  border-radius: 999rpx;
  background: linear-gradient(180deg, rgba(232,198,106,.2), rgba(12,10,8,.35));
  color: #e8c66a;
  font-size: 32rpx; letter-spacing: 12rpx; padding-left: 12rpx;
  pointer-events:none; opacity:0; transform: translateY(16rpx);
}
.op-btn.on {
  opacity:1; pointer-events:auto;
  animation: btnIn .45s cubic-bezier(.2,.8,.3,1) both, btnPulse 1.8s ease-in-out infinite;
}
@keyframes btnIn {
  0% { opacity:0; transform: translateY(24rpx); }
  100% { opacity:1; transform: translateY(0); }
}
@keyframes btnPulse {
  0%,100% { box-shadow: 0 0 0 0 rgba(232,198,106,.28); }
  50% { box-shadow: 0 0 0 18rpx rgba(232,198,106,0); }
}
