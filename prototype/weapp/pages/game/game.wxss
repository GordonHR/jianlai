/* ===== 空舞台：playName 为空时整块不渲染（已在 wxml 用 wx:if 控），无需样式兜底 ===== */
.stage.empty-hint { /* 占位：未来若有"等待出牌"提示 */ }

/* ===== 选目标提示（battlefield 中央顶部，await 时显示） ===== */
.await-prompt {
  position:absolute; top:340rpx; left:50%; transform:translateX(-50%);
  z-index:11; display:flex; flex-direction:column; align-items:center;
  pointer-events:none;
}
.await-prompt .ap-arrow {
  font-size:36rpx; color:#e8c66a; font-weight:bold;
  text-shadow:0 0 12rpx rgba(232,198,106,.55), 0 2rpx 4rpx rgba(0,0,0,.7);
  animation: apArrow 1.1s ease-in-out infinite;
  margin-bottom:6rpx;
}
.await-prompt .ap-text {
  font-size:24rpx; color:#fbe7b2; background:rgba(20,17,15,.92);
  border:2rpx solid #c9a24b; border-radius:10rpx;
  padding:10rpx 22rpx; letter-spacing:3rpx;
  box-shadow:0 4rpx 14rpx rgba(0,0,0,.7), inset 0 0 0 1rpx #6a5328;
}
@keyframes apArrow {
  0%,100% { transform:translateY(-4rpx); opacity:.7; }
  50%     { transform:translateY(6rpx);  opacity:1; }
}
