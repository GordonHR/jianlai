page { background:#14110f; color:#e8e0d2; }

.game {
  display:flex; flex-direction:column; height:100vh; box-sizing:border-box;
  background:#14110f;
}
.loading { display:flex; align-items:center; justify-content:center; height:100vh; color:#c9a24b; letter-spacing:6rpx; }

/* 顶栏 */
.topbar { padding:8rpx 14rpx; background:rgba(20,17,15,.94); border-bottom:1rpx solid #3a2f23; }
.turn-banner { display:flex; align-items:center; flex-wrap:wrap; gap:10rpx; }
.phase { font-size:24rpx; color:#c9a24b; font-weight:bold; }
.phase.siege, .phase.boss { color:#ff8a6b; }
.turn { font-size:28rpx; font-weight:bold; margin-left:auto; }
.tfac { font-size:22rpx; }
.stepper { display:flex; align-items:center; justify-content:center; gap:6rpx; width:100%; margin-top:4rpx; }
.st { font-size:20rpx; color:#7a6f5e; padding:3rpx 12rpx; border-radius:20rpx; background:#2a2118; }
.st.on { color:#14110f; background:#e8c66a; }
.st.done { color:#9ed4be; }
.arw { color:#5a4d3b; font-size:18rpx; }
.topctrl { display:flex; align-items:center; gap:8rpx; margin-top:4rpx; flex-wrap:wrap; }
.counts { font-size:20rpx; color:#8a7e6c; }
.bg-btn { font-size:20rpx; padding:6rpx 14rpx; border:1rpx solid #3a2f23; border-radius:8rpx; color:#c9a24b; }
.bg-btn.off { color:#6a5e4c; }
.bg-btn.on { color:#241c08; background:#c9a24b; border-color:#c9a24b; }
.trustee-tag { color:#c9a24b; margin-left:10rpx; }

/* 通用按钮 */
.btn { font-size:24rpx; padding:10rpx 22rpx; border-radius:10rpx; background:#3a2f23; color:#e8e0d2; }
.btn.primary { background:#c9a24b; color:#14110f; font-weight:bold; }
.btn.ghost { background:transparent; border:1rpx solid #5a4d3b; }
.btn.disabled { opacity:.4; }

/* 战场：四角站位，中间舞台 */
.battlefield { position:relative; flex:1; overflow:hidden; background:#14110f; }
/* 极淡暗角：古风写意味，非 AI 光晕 */
.battlefield::after {
  content:""; position:absolute; inset:0; pointer-events:none; z-index:1;
  background:radial-gradient(ellipse at 50% 45%, transparent 54%, rgba(0,0,0,.42) 100%);
}
/* 战场景别（换景按钮驱动，纯 CSS 零资源；中央环纹对齐三国杀舞台浮雕） */
.battle-bg { position:absolute; inset:0; z-index:0; pointer-events:none; overflow:hidden;
             background:#14110f;
             background-image:radial-gradient(ellipse at 50% 42%, rgba(64,50,30,.34) 0%, transparent 62%); }
.battle-bg.sc-1 { background:#12161b; background-image:radial-gradient(ellipse at 50% 40%, rgba(118,138,158,.12) 0%, transparent 60%); }
.battle-bg.sc-2 { background:#170f0b; background-image:radial-gradient(ellipse at 50% 88%, rgba(196,92,44,.13) 0%, transparent 58%); }
.bg-ring  { position:absolute; left:50%; top:44%; transform:translate(-50%,-50%); width:580rpx; height:580rpx; border-radius:50%; border:1rpx solid rgba(201,162,75,.13); }
.bg-ring2 { position:absolute; left:50%; top:44%; transform:translate(-50%,-50%); width:420rpx; height:420rpx; border-radius:50%; border:1rpx solid rgba(201,162,75,.09); }
.bg-ring2::before { content:""; position:absolute; inset:28rpx; border-radius:50%; border:1rpx dashed rgba(201,162,75,.08); }
.bg-char  { position:absolute; left:50%; top:44%; transform:translate(-50%,-50%); font-family:"KaiTi","STKaiti",serif; font-size:430rpx; line-height:1; color:rgba(201,162,75,.05); }

/* 四角座位卡（对齐三国杀大卡：约屏宽 1/4） */
.seat { position:relative; box-sizing:border-box; width:200rpx; height:280rpx; background:#1d1712; border:2rpx solid #3a2f23; border-radius:18rpx; padding:10rpx; display:flex; flex-direction:column; }
.seat.dead { opacity:.45; filter:grayscale(1); }
/* 目标可选：实色金边 + 金底圆点（无金色光晕，避 iPhone 紫偏） */
.seat.clickable { border-color:#e8c66a; box-shadow:inset 0 0 0 2rpx #e8c66a, 0 4rpx 12rpx rgba(0,0,0,.55); animation:seatPulse 1.2s ease-in-out infinite; }
/* 当前行动：实色金边 + 深阴影 + 顶部行动横幅（座位卡底部"出牌思考中"横条） */
.seat.current { border-color:#c9a24b; box-shadow:inset 0 0 0 2rpx #c9a24b, 0 4rpx 16rpx rgba(0,0,0,.65); }
@keyframes seatPulse {
  0%,100% { box-shadow:inset 0 0 0 2rpx #e8c66a, 0 4rpx 12rpx rgba(0,0,0,.55); }
  50%     { box-shadow:inset 0 0 0 3rpx #ffd966, 0 4rpx 14rpx rgba(0,0,0,.6); }
}
.seat-portrait { position:relative; flex:1; width:100%; min-height:0; border-radius:10rpx; overflow:hidden; background:#2a2118; }
.seat-img { width:100%; height:100%; }
.seat-initial { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font-size:30rpx; font-weight:bold; color:rgba(232,198,106,.35); letter-spacing:6rpx; }
.seat-name { position:absolute; left:0; bottom:0; width:100%; box-sizing:border-box; background:rgba(0,0,0,.62); font-size:22rpx; padding:4rpx 8rpx; color:#f0e8d2; }
.seat-fac { position:absolute; left:0; top:0; right:0; font-size:18rpx; line-height:1; padding:5rpx 10rpx; background:rgba(20,17,15,.85); color:inherit; letter-spacing:2rpx; border-bottom:1rpx solid #3a2f23; }
.seat-fac.enemy { background:#4a1f1f; color:#f0c4bc; border-bottom-color:rgba(160,42,63,.55); }
.seat-fac.friend { background:#163a35; color:#aee0d4; border-bottom-color:rgba(63,160,144,.55); }
.seat-fac.neutral { background:#4a3a22; color:#e8c66a; border-bottom-color:#6a5328; }
.seat-hp { position:absolute; left:6rpx; bottom:34rpx; font-size:18rpx; padding:2rpx 8rpx; border-radius:6rpx; background:linear-gradient(180deg,#c0392b,#8e44ad); color:#fff; }
/* 装备（本命飞剑）小签 + 手牌数徽章：对齐三国杀卡面信息密度 */
.seat-equip { position:absolute; left:6rpx; bottom:70rpx; font-size:16rpx; padding:2rpx 8rpx; border-radius:6rpx; background:rgba(20,17,15,.82); border:1rpx solid #6a5328; color:#e8c66a; }
.seat-cnt { position:absolute; right:6rpx; bottom:34rpx; min-width:38rpx; height:38rpx; padding:0 8rpx; border-radius:19rpx; background:rgba(20,17,15,.86); border:1rpx solid #c9a24b; color:#e8c66a; font-size:22rpx; font-weight:bold; display:flex; align-items:center; justify-content:center; }
/* 号位脚注（卡下方一行：三号位 · 来犯之敌） */
.seat-foot { flex:0 0 auto; display:flex; align-items:center; justify-content:center; gap:8rpx; padding:4rpx 0 0; font-size:18rpx; color:#a4977f; letter-spacing:1rpx; }
.seat-foot .sf-side { color:#7a6f5e; }
.seat-dead { position:absolute; inset:0; z-index:3; display:flex; flex-direction:column; align-items:center; justify-content:center; background:rgba(8,6,5,.55); }
/* 阵亡朱印：旋转描边印章（对齐三国杀阵亡盖章演出） */
.sd-stamp { transform:rotate(-8deg); padding:6rpx 12rpx 6rpx 22rpx; border:3rpx solid #a83a2c; border-radius:8rpx; box-shadow:inset 0 0 0 1rpx rgba(168,58,44,.5); color:#d96b57; font-size:34rpx; font-weight:900; letter-spacing:10rpx; background:rgba(24,10,8,.4); }
/* 阵亡角色 "已离开" 副标签 */
.seat-left-tag { display:block; font-size:18rpx; font-weight:normal; color:#9a9180; letter-spacing:4rpx; margin-top:8rpx; opacity:.88; }
/* 当前行动者底部"出牌思考中"横幅（仿三国杀"出牌思考中"） */
.seat-thinking { position:absolute; left:0; right:0; bottom:0; font-size:20rpx; color:#14110f; background:linear-gradient(180deg,#ffd966,#c9a24b); text-align:center; padding:4rpx 6rpx; font-weight:bold; letter-spacing:2rpx; border-top:2rpx solid #6a5328; box-shadow:0 -2rpx 6rpx rgba(0,0,0,.5); }
.seat-turn { position:absolute; left:0; right:0; bottom:0; font-size:20rpx; color:#14110f; background:linear-gradient(180deg,#fff1c2,#ffd966); text-align:center; padding:4rpx 6rpx; font-weight:bold; letter-spacing:2rpx; border-top:2rpx solid #6a5328; box-shadow:0 -2rpx 6rpx rgba(0,0,0,.5); }
.seat-tgt { position:absolute; right:6rpx; top:50%; transform:translateY(-50%); font-size:30rpx; color:#14110f; background:#c9a24b; width:40rpx; height:40rpx; border-radius:50%; display:flex; align-items:center; justify-content:center; box-shadow:0 2rpx 6rpx rgba(0,0,0,.55); }

/* 四角定位 */
.seat-top { position:absolute; top:16rpx; left:50%; transform:translateX(-50%); z-index:10; }
.seat-top .seat-scroll { display:flex; gap:14rpx; }
.seat-left { position:absolute; top:50%; left:16rpx; transform:translateY(-50%); z-index:10; }
.seat-right { position:absolute; top:50%; right:16rpx; transform:translateY(-50%); z-index:10; }
/* 三国杀手牌在左、自家在右的镜像布局（用 row-reverse 不动 HTML 结构） */
.seat-bottom { position:absolute; left:16rpx; right:16rpx; bottom:16rpx; z-index:10; display:flex; gap:14rpx; align-items:flex-end; flex-direction:row-reverse; }

/* 中间舞台：出牌动态演出区（平时空，出牌/技能时打出牌飞入放大再淡出，不常驻） */
.stage { position:absolute; top:300rpx; left:220rpx; right:220rpx; bottom:360rpx; z-index:5; display:flex; flex-direction:column; align-items:center; justify-content:center; }
.stage-play { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; pointer-events:none; z-index:6; }
.sp-name {
  font-size:56rpx; font-weight:900; letter-spacing:8rpx; color:#5c2525;
  padding:16rpx 36rpx; border-radius:16rpx;
  background:linear-gradient(180deg,#f4ead0 0%,#dcc896 100%);
  border:2rpx solid #6a5328;
  box-shadow:0 8rpx 28rpx rgba(0,0,0,.7), inset 0 0 0 1rpx #6a5328;
  text-shadow:0 1rpx 0 #f4ead0;
  animation:stagePlayIn 1.6s ease-out forwards;
}
@keyframes stagePlayIn {
  0%   { opacity:0; transform:translateY(80rpx) scale(.6); }
  28%  { opacity:1; transform:translateY(0) scale(1.12); }
  45%  { opacity:1; transform:translateY(0) scale(1); }
  75%  { opacity:1; transform:translateY(0) scale(1); }
  100% { opacity:0; transform:translateY(-30rpx) scale(.92); }
}
.stage-hint { text-align:center; margin-bottom:16rpx; }
.stage-name { font-family:"KaiTi","STKaiti",serif; font-size:40rpx; font-weight:bold; letter-spacing:4rpx; }
.stage-tag { display:block; font-size:22rpx; color:#b9ad8f; margin-top:6rpx; letter-spacing:4rpx; }
.stage-center { display:flex; gap:40rpx; align-items:center; justify-content:center; margin-bottom:16rpx; }
.pile { width:120rpx; height:160rpx; border-radius:12rpx; background:#211b16; border:1rpx solid #3a2f23; display:flex; flex-direction:column; align-items:center; justify-content:center; }
.pile .n { font-size:40rpx; font-weight:bold; color:#c9a24b; }
.pile .l { font-size:20rpx; color:#8a7e6c; margin-top:6rpx; }
.stage-log { width:100%; max-width:600rpx; background:rgba(0,0,0,.42); border-radius:12rpx; padding:14rpx 18rpx; box-sizing:border-box; border:1rpx solid #3a2f23; z-index:4; }
.stage-log .lg { font-size:24rpx; line-height:1.7; color:#cabf9f; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.stage-log .lg-sys { color:#9ed4be; }
.stage-log .lg-big { color:#e8c66a; font-weight:bold; }
.stage-log .lg-hit { color:#ff8a6b; }
.stage-log .lg-heal { color:#79e6a0; }
/* 当前行动高亮：实色金边 + 深阴影（金色光晕易 iPhone 紫偏，改用深度阴影） */
.seat.current { border-color:#c9a24b; box-shadow:inset 0 0 0 2rpx #c9a24b, 0 4rpx 16rpx rgba(0,0,0,.65); }
/* 目标可选：实色金边 + 金底圆点（无金色光晕，避 iPhone 紫偏） */
.seat.clickable { border-color:#e8c66a; box-shadow:inset 0 0 0 2rpx #e8c66a, 0 4rpx 12rpx rgba(0,0,0,.55); animation:seatPulse 1.2s ease-in-out infinite; }
@keyframes seatPulse {
  0%,100% { box-shadow:inset 0 0 0 2rpx #e8c66a, 0 4rpx 12rpx rgba(0,0,0,.55); }
  50%     { box-shadow:inset 0 0 0 3rpx #ffd966, 0 4rpx 14rpx rgba(0,0,0,.6); }
}
/* 战报收起：默认仅留最新一条 */
.stage-log.fold { max-height:48rpx; overflow:hidden; }
.log-toggle { font-size:18rpx; color:#8a7e6c; margin-top:8rpx; text-align:center; letter-spacing:2rpx; }
/* 中央虚拟出牌卡（对齐三国杀白牌：白底+金字+插画+目标） */
.stage-card { width:200rpx; height:280rpx; border-radius:18rpx; background:linear-gradient(180deg,#f4ead0 0%,#dcc896 100%); border:2rpx solid #6a5328; box-shadow:0 6rpx 24rpx rgba(0,0,0,.55), inset 0 0 0 1rpx #6a5328; display:flex; flex-direction:column; align-items:center; justify-content:flex-start; padding:16rpx 10rpx 14rpx; box-sizing:border-box; }
.stage-card .sc-label { font-size:22rpx; color:#6a5328; letter-spacing:4rpx; font-weight:bold; margin-bottom:12rpx; }
.stage-card .sc-name { font-size:36rpx; font-weight:bold; color:#5c2525; text-align:center; line-height:1.25; text-shadow:0 1rpx 0 #f4ead0; word-break:keep-all; }
.stage-card .sc-target { display:block; font-size:20rpx; color:#6a5328; margin-top:10rpx; letter-spacing:2rpx; opacity:.9; }

/* 底部：自己 + 手牌 + 技能（对齐三国杀大立绘：右下角竖向，约 150×260，不抢手牌宽度） */
.my-card { width:150rpx; flex:0 0 150rpx; min-height:260rpx; background:#1d1712; border:2rpx solid #3a2f23; border-radius:16rpx; padding:8rpx; box-sizing:border-box; display:flex; flex-direction:column; }
.my-card.dead { opacity:.45; filter:grayscale(1); }
.my-portrait { position:relative; flex:1; width:100%; min-height:170rpx; border-radius:10rpx; overflow:hidden; background:#2a2118; }
.my-img { width:100%; height:100%; }
.my-initial { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font-size:60rpx; font-weight:bold; opacity:.22; }
.my-name { position:absolute; left:0; bottom:0; width:100%; box-sizing:border-box; background:rgba(0,0,0,.62); font-size:18rpx; padding:3rpx 6rpx; color:#f0e8d2; letter-spacing:1rpx; }
.my-hp { position:absolute; left:5rpx; bottom:28rpx; font-size:16rpx; padding:1rpx 6rpx; border-radius:5rpx; background:linear-gradient(180deg,#c0392b,#8e44ad); color:#fff; }
.my-seat { position:absolute; right:6rpx; top:6rpx; font-size:18rpx; padding:2rpx 8rpx; border-radius:6rpx; background:#e8c66a; color:#14110f; }
.my-dead { position:absolute; inset:0; z-index:3; display:flex; align-items:center; justify-content:center; background:rgba(8,6,5,.55); }
.my-dead .sd-stamp { font-size:42rpx; letter-spacing:12rpx; padding:8rpx 14rpx 8rpx 26rpx; }
/* 怒气 / 装备位（design-strategist 配合） */
.my-extra { margin-top:8rpx; display:flex; flex-direction:column; gap:4rpx; }
.my-qi { font-size:20rpx; color:#e8c66a; }
.my-wenjian { font-size:20rpx; color:#e8c66a; }
.my-equip { font-size:20rpx; color:#c9a24b; margin-top:4rpx; }
/* 血条（design-strategist-2 后补，需补样式兜底） */
.my-hpbar { position:absolute; left:6rpx; right:6rpx; bottom:6rpx; height:10rpx; background:rgba(0,0,0,.6); border:1rpx solid #3a2f23; border-radius:6rpx; overflow:hidden; }
.my-hpbar-fill { display:block; height:100%; background:linear-gradient(90deg,#c9a24b 0%,#e0795f 60%,#8e44ad 100%); box-shadow:0 0 6rpx rgba(232,121,95,.5); }
.my-area { flex:1; min-width:0; display:flex; flex-direction:column; gap:8rpx; }
.my-title { display:flex; align-items:center; gap:10rpx; font-size:22rpx; color:#c9a24b; flex-wrap:wrap; }
.atkinfo, .wine { font-size:18rpx; color:#8a7e6c; }
.wine { color:#e8c66a; }
.hand { display:flex; gap:12rpx; overflow-x:auto; padding-bottom:8rpx; min-height:160rpx; align-items:flex-start; width:100%; box-sizing:border-box; }
.card { flex:0 0 190rpx; width:190rpx; background:#211b16; border:2rpx solid #3a2f23; border-radius:16rpx; padding:8rpx; box-sizing:border-box; display:flex; flex-direction:column; }
.card.disabled { opacity:.35; }
/* 弃牌多选态（对齐三国杀）：可选手牌微亮，选中牌金边抬起 */
.card.mp { border-color:#6a5328; box-shadow:0 0 0 1rpx rgba(232,198,106,.25); }
.card.mp-on { transform:translateY(-24rpx); border-color:#c9a24b; box-shadow:0 8rpx 20rpx rgba(0,0,0,.6), inset 0 0 0 2rpx #c9a24b, 0 0 14rpx rgba(232,198,106,.35); z-index:6; }
.cf-head { font-size:22rpx; font-weight:bold; display:flex; align-items:center; gap:6rpx; }
.cf-point { flex:0 0 auto; font-size:26rpx; font-weight:bold; background:linear-gradient(180deg,#f4ead0,#c9a24b); color:#5c2525; border-radius:8rpx; min-width:40rpx; height:40rpx; padding:0 8rpx; display:inline-flex; align-items:center; justify-content:center; box-shadow:0 1rpx 4rpx rgba(0,0,0,.4); }
.cf-art { position:relative; flex:1; min-height:150rpx; margin:8rpx 0; border-radius:10rpx; background:linear-gradient(160deg,#2a2118,#1a1410); border:1rpx solid #3a2f23; display:flex; align-items:center; justify-content:center; overflow:hidden; }
.cf-img { position:absolute; inset:0; width:100%; height:100%; }
.cf-sig { font-size:52rpx; color:#9ed4be; text-shadow:0 0 12rpx rgba(158,212,190,.5); }
/* 有插画时：单字退为淡墨底纹兜底（SVG 未渲染时仍可见） */
.cf-art.has-img .cf-sig { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font-size:64rpx; opacity:.12; }
.cf-foot { flex:0 0 auto; font-size:22rpx; color:#cdbfa1; text-align:center; padding-top:6rpx; border-top:1rpx solid #3a2f23; letter-spacing:1rpx; }
.cardback { flex:0 0 90rpx; width:90rpx; height:120rpx; background:linear-gradient(135deg,#3a2f23,#211b16); border:1rpx solid #c9a24b; border-radius:10rpx; display:flex; align-items:center; justify-content:center; color:#c9a24b; font-size:40rpx; }
.wait { font-size:20rpx; color:#6a5e4c; padding:16rpx 0; }
.cancel-await { flex:0 0 auto; align-self:center; margin-left:20rpx; min-height:56rpx; display:flex; align-items:center; color:#c0b6a4; }
.skills { display:flex; gap:12rpx; flex-wrap:wrap; }
.skill { flex:1 1 auto; min-width:140rpx; text-align:center; padding:16rpx 10rpx; font-size:26rpx; font-weight:bold; letter-spacing:2rpx; background:linear-gradient(180deg,#2f2618,#211b16); border:2rpx solid #c9a24b; color:#e8c66a; border-radius:12rpx; box-shadow:0 2rpx 10rpx rgba(0,0,0,.4), inset 0 0 0 1rpx #6a5328; }

/* 出牌确认条：抬起选中后浮现 */
.play-bar { display:flex; gap:14rpx; padding:4rpx 0 8rpx; }
.play-bar .btn { flex:0 0 auto; }
/* 手牌横向滚动行（永远展开，不折叠） */
.hand-scroll { width:100%; white-space:nowrap; }
.hand-row { display:inline-flex; gap:12rpx; padding:30rpx 0 8rpx; min-height:200rpx; align-items:flex-start; }
/* 选中抬起态：实色金边 + 深阴影 */
.card.sel { transform:translateY(-24rpx); border-color:#c9a24b; box-shadow:0 8rpx 20rpx rgba(0,0,0,.6), inset 0 0 0 2rpx #c9a24b; z-index:6; }

/* 浮动底栏：左下排序 + 右下表情/聊天（对齐三国杀） */
.float-bar { position:absolute; left:0; right:0; bottom:0; display:flex; justify-content:space-between; align-items:flex-end; padding:0 20rpx calc(20rpx + env(safe-area-inset-bottom)); z-index:11; pointer-events:none; }
.float-bar > .float-btn { pointer-events:auto; }
.float-btn { display:flex; align-items:center; justify-content:center; min-width:88rpx; height:72rpx; padding:0 24rpx; border-radius:36rpx; background:rgba(20,17,15,.85); border:1rpx solid #6a5328; color:#e8c66a; font-size:24rpx; letter-spacing:2rpx; box-shadow:0 4rpx 14rpx rgba(0,0,0,.5); }
.float-btn:active { background:rgba(20,17,15,1); }
.float-right { display:flex; gap:14rpx; align-items:flex-end; }
.float-right .float-btn { min-width:72rpx; height:72rpx; padding:0; font-size:30rpx; border-radius:50%; }
.chat-emoji { color:#e8c66a; }
.chat-msg { color:#9ed4be; }

/* 弹窗：古风卷轴 + 剑印 */
.modal-mask { position:fixed; inset:0; background:rgba(8,6,12,.78); display:flex; align-items:flex-start; justify-content:center; padding-top:26vh; z-index:50; }
.modal-frame { position:relative; width:82%; max-width:560rpx; background:#1d1712; border:2rpx solid #8a7448; border-radius:16rpx; padding:0 0 22rpx; box-sizing:border-box; }
.modal-frame::before, .modal-frame::after { content:""; position:absolute; left:24rpx; right:24rpx; height:1rpx; background:#3a2f23; }
.modal-frame::before { top:8rpx; }
.modal-frame::after { bottom:8rpx; }
.modal-crest { height:70rpx; display:flex; align-items:center; justify-content:center; position:relative; border-bottom:1rpx solid #3a2f23; margin:0 24rpx; padding:14rpx 0 10rpx; }
.crest-sword { position:absolute; width:66rpx; height:6rpx; background:#c9a24b; border-radius:2rpx; }
.crest-sword::before { content:""; position:absolute; right:-6rpx; top:-4rpx; width:10rpx; height:14rpx; background:#c9a24b; border-radius:2rpx; }
.crest-sword.sl { transform:rotate(38deg); }
.crest-sword.sr { transform:rotate(-38deg); }
.crest-seal { width:22rpx; height:22rpx; border-radius:50%; background:#a02a3f; border:2rpx solid #c9a24b; }
.modal-prompt { font-size:28rpx; color:#fdf6e3; line-height:1.8; text-align:center; padding:24rpx 28rpx 18rpx; }
.modal-seal-btns { display:flex; flex-direction:column; gap:14rpx; padding:0 28rpx; }
.seal-btn { padding:18rpx 0; text-align:center; border:1rpx solid #5a4d3b; border-radius:10rpx; background:#211b16; color:#d8d0c0; font-size:26rpx; letter-spacing:4rpx; }
.seal-btn.primary { background:#5c2525; border-color:#8f3434; color:#fdf6e3; }
.seal-btn.disabled { opacity:.45; }
.modal-roll-end { display:flex; justify-content:space-between; padding:0 32rpx; margin-top:14rpx; }
.modal-roll-end view { width:14rpx; height:14rpx; border-radius:50%; border:1rpx solid #c9a24b; background:#14110f; }
.modal-box { width:82%; background:#211b16; border:2rpx solid #c9a24b; border-radius:16rpx; padding:30rpx; box-sizing:border-box; }
.modal-text { font-size:26rpx; line-height:1.6; margin-bottom:24rpx; }
.modal-btns { display:flex; flex-direction:column; gap:14rpx; }
/* 弃牌等多选：中央浮出确认条（对齐三国杀「确定/取消」中置，说明文字在下） */
.multi-bar { position:fixed; left:50%; transform:translateX(-50%); bottom:430rpx; z-index:12;
             display:flex; flex-direction:column; align-items:center; gap:8rpx; max-width:92%;
             background:rgba(20,17,15,.94); border:2rpx solid #c9a24b; border-radius:14rpx;
             padding:12rpx 20rpx; box-sizing:border-box;
             box-shadow:0 8rpx 24rpx rgba(0,0,0,.7), inset 0 0 0 1rpx #6a5328; }
.mb-btns { display:flex; align-items:center; gap:16rpx; }
.mb-count { font-size:22rpx; color:#e8c66a; font-weight:bold; }
.mb-text { font-size:20rpx; color:#cabf9f; text-align:center; line-height:1.5; }
.multi-bar .btn { min-width:200rpx; padding:0 30rpx; }

/* 结算 */
.result-mask { position:fixed; inset:0; background:rgba(0,0,0,.85); display:flex; align-items:center; justify-content:center; z-index:60; }
.result { width:88%; max-height:88%; overflow-y:auto; border:2rpx solid #c9a24b; border-radius:18rpx; padding:48rpx 36rpx 36rpx; box-sizing:border-box; position:relative;
          background:
            radial-gradient(ellipse at 50% 0%, rgba(255,200,90,.42) 0%, rgba(255,150,60,.18) 18%, transparent 50%),
            radial-gradient(ellipse at 50% 100%, rgba(255,180,80,.18) 0%, transparent 60%),
            linear-gradient(180deg, #3a2614 0%, #2a1b0e 32%, #1a120a 100%); overflow:hidden; }
.rs-title { font-size:80rpx; text-align:center; font-weight:bold; }
.rs-title.win { color:#e8c66a; }
.rs-title.lose { color:#ff8a6b; }
.rs-sub { text-align:center; font-size:24rpx; color:#b8ac98; margin:10rpx 0 24rpx; }
.rs-portrait { display:flex; justify-content:center; margin-bottom:20rpx; }
.rsp { width:160rpx; height:240rpx; border-radius:12rpx; border:2rpx solid #c9a24b; }

/* 加冕时刻：参考全场最佳卡的金光火焰感 */
.rs-mvp-wrap { position:relative; display:flex; flex-direction:column; align-items:center; margin:6rpx 0 24rpx; }
.rs-mvp-card { position:relative; width:320rpx; height:440rpx; border-radius:24rpx; overflow:visible;
               border:2rpx solid rgba(255,225,160,.95); background:#1a1620;
               box-shadow:
                 0 22rpx 56rpx rgba(0,0,0,.78),
                 0 0 44rpx rgba(255,200,80,.55), 0 0 86rpx rgba(232,160,60,.45), 0 0 128rpx rgba(255,140,40,.3),
                 inset 0 0 0 1rpx rgba(255,235,170,.45); }
.rs-mvp-card::before { content:""; position:absolute; left:8rpx; right:8rpx; top:8rpx; bottom:8rpx;
                       border:1rpx solid rgba(255,225,160,.7); border-radius:18rpx; pointer-events:none; z-index:3; }
.rs-mvp-banner { position:relative; z-index:4; margin:-60rpx 32rpx 0; padding:0; background:transparent; border:0;
                 box-shadow:none; display:flex; flex-direction:column; align-items:center; line-height:1; }
.rs-mvp-banner .rs-mvp-banner-t { font-size:60rpx; font-weight:900; letter-spacing:24rpx; color:#1a0e04;
                                  text-shadow:
                                    1rpx 0 0 #c89b3f, -1rpx 0 0 #c89b3f, 0 1rpx 0 #c89b3f, 0 -1rpx 0 #c89b3f,
                                    2rpx 0 0 #8a6a1f, -2rpx 0 0 #8a6a1f, 0 2rpx 0 #8a6a1f, 0 -2rpx 0 #8a6a1f,
                                    /* 火苗 */
                                    0 -16rpx 32rpx #ff9050, 0 -8rpx 16rpx rgba(255,180,90,.7),
                                    0 12rpx 44rpx #ffc080, 0 28rpx 76rpx rgba(255,180,80,.55),
                                    0 -36rpx 72rpx rgba(255,120,40,.45); }
.rs-mvp-banner small { font-size:20rpx; letter-spacing:6rpx; opacity:.9; margin-top:16rpx; color:#c9a24b;
                       text-shadow:0 1rpx 2rpx rgba(0,0,0,.7); font-weight:400; }
.rs-mvp-banner .rs-mvp-flame-t { position:absolute; top:-12rpx; left:50%; transform:translateX(-50%);
                                 width:120%; height:16rpx; pointer-events:none; opacity:.55;
                                 background:radial-gradient(ellipse at 50% 80%, rgba(255,180,90,.85) 0%, rgba(255,120,40,.55) 30%, transparent 70%); }
.rs-mvp-banner .rs-mvp-flame-b { position:absolute; top:16rpx; left:50%; transform:translateX(-50%);
                                 width:130%; height:12rpx; pointer-events:none; opacity:.7;
                                 background:radial-gradient(ellipse at 50% 20%, rgba(255,210,120,.8) 0%, transparent 70%); }
.rs-mvp-art { position:absolute; left:0; right:0; top:0; bottom:0; z-index:1; }
.rsmvpi { width:100%; height:100%; }
.rs-mvp-art::after { content:""; position:absolute; inset:0; pointer-events:none;
                     background:linear-gradient(180deg,transparent 50%,rgba(8,5,3,.78) 100%); }
.rs-mvp-flame { position:absolute; left:-12%; right:-12%; bottom:-30rpx; height:120rpx; z-index:2; pointer-events:none;
                background:radial-gradient(ellipse at 50% 80%, rgba(232,198,106,.55) 0%, rgba(232,150,80,.35) 26%, transparent 60%); }
.rs-mvp-flame::before { content:""; position:absolute; left:50%; transform:translateX(-50%); bottom:-40rpx;
                        width:160%; height:160rpx; border-radius:50%;
                        background:radial-gradient(ellipse at 50% 40%, rgba(255,210,120,.42) 0%, transparent 65%); }
.rs-mvp-name { position:absolute; left:0; right:0; bottom:20rpx; z-index:5; text-align:center;
               font-size:34rpx; font-weight:bold; letter-spacing:6rpx; color:#fbe7b2;
               text-shadow:0 0 16rpx rgba(232,198,106,.8), 0 2rpx 6rpx #000; }
.rs-mvp-name .mvp-fac { display:block; font-size:18rpx; letter-spacing:3rpx; margin-top:6rpx;
                        color:#e8c66a; opacity:.92; font-weight:normal; }
.rs-mvp-stats { display:flex; justify-content:center; gap:20rpx; margin-top:18rpx; }
.rs-mvp-stat { text-align:center; min-width:90rpx; padding:10rpx 14rpx 8rpx;
               background:rgba(20,16,26,.7); border:1rpx solid #6a5328; border-radius:12rpx; }
.rs-mvp-stat b { display:block; font-size:34rpx; color:#f6e2b0;
                 text-shadow:0 0 18rpx rgba(232,198,106,.45); font-weight:bold; }
.rs-mvp-stat text { font-size:18rpx; color:#9a917f; letter-spacing:3rpx; }
.rs-lose-card { width:260rpx; height:360rpx; margin:0 auto 20rpx; border-radius:16rpx; overflow:hidden;
                border:1rpx solid rgba(255,138,122,.35);
                box-shadow:0 0 36rpx rgba(160,60,50,.18); filter:grayscale(.4) brightness(.92); }
.rslci { width:100%; height:100%; }
/* 本局成就卡 */
.rs-ach { width:560rpx; max-width:86vw; margin:24rpx auto 4rpx; padding:24rpx 30rpx 28rpx; border-radius:18rpx; text-align:center;
          border:1rpx solid #6a5328; background:linear-gradient(180deg,rgba(28,24,18,.7),rgba(18,16,24,.66));
          box-shadow:0 8rpx 36rpx rgba(0,0,0,.4); }
.rs-ach .rs-ach-grade { font-size:20rpx; letter-spacing:8rpx; color:#9c8754; }
.rs-ach .rs-ach-title { font-size:48rpx; letter-spacing:14rpx; margin:12rpx 0 14rpx; font-weight:700;
                        color:#e8c66a; text-shadow:0 0 22rpx rgba(232,198,106,.38); }
.rs-ach .rs-ach-note { font-size:22rpx; line-height:1.75; color:#cdbfa1; letter-spacing:2rpx; }
.rs-ach.rs-ach-lose { border-color:rgba(150,150,162,.32); background:linear-gradient(180deg,rgba(20,20,24,.66),rgba(16,16,20,.6)); }
.rs-ach.rs-ach-lose .rs-ach-grade { color:#8b8d96; }
.rs-ach.rs-ach-lose .rs-ach-title { color:#aeb0bb; text-shadow:none; }
.rs-ach.rs-ach-lose .rs-ach-note { color:#8b8d96; }
.rs-grade-divine .rs-ach-title { color:#d9b3ff; text-shadow:0 0 26rpx rgba(190,140,255,.5); }
.rs-grade-high   .rs-ach-title { color:#ffe1a3; }
.rs-grade-mid    .rs-ach-title { color:#bfe9c9; }
.rs-grade-low    .rs-ach-title { color:#b9bcc6; }
.rs-stats { font-size:20rpx; }
.rs-row { display:flex; justify-content:space-between; padding:10rpx 0; border-bottom:1rpx solid #2a2118; }
.rs-row text { flex:1; text-align:center; }
.rs-head { color:#c9a24b; }
.win-row { background:rgba(232,198,106,.1); }
.rs-recap-bar { display:flex; justify-content:space-between; align-items:center; margin-top:20rpx; padding:14rpx 18rpx; min-height:60rpx; box-sizing:border-box; border:1rpx solid #3a2f23; border-radius:10rpx; font-size:22rpx; color:#c9a24b; letter-spacing:2rpx; }
.rs-recap-arw { color:#8a7e6c; font-size:20rpx; }
.rs-recap { max-height:380rpx; margin-top:12rpx; padding:12rpx 14rpx; box-sizing:border-box; background:rgba(0,0,0,.28); border-radius:10rpx; }
.rs-btns { display:flex; gap:20rpx; margin-top:24rpx; }
.rs-btns .btn { flex:1; text-align:center; }

/* 瞬时特效 */
@keyframes fxIn { from { opacity:0; transform:scale(.8);} to { opacity:1; transform:scale(1);} }
.banner-fx { position:fixed; top:30%; left:0; width:100%; text-align:center; z-index:70; pointer-events:none; animation:fxIn .25s ease-out; }
.bn-name { font-size:60rpx; font-weight:bold; color:#e8c66a; text-shadow:0 2rpx 10rpx #000; }
.bn-sub { font-size:28rpx; color:#fff; letter-spacing:8rpx; }
.flash-fx { position:fixed; top:40%; left:0; width:100%; text-align:center; z-index:70; pointer-events:none; animation:fxIn .2s ease-out; }
.exec-word { font-size:120rpx; color:#ff8a6b; font-weight:bold; text-shadow:0 0 20rpx #ff8a6b; }
.exec-sub { font-size:28rpx; color:#fff; }
.shout-fx { position:fixed; top:20%; left:0; width:100%; text-align:center; z-index:65; font-size:40rpx; font-weight:bold; pointer-events:none; text-shadow:0 2rpx 8rpx #000; animation:fxIn .25s ease-out; }
/* 画意·朱砂印：旗舰招式题字旁的落印 */
.shout-seal {
  position:absolute; left:50%; bottom:-34rpx; margin-left:-23rpx;
  width:46rpx; height:46rpx; display:flex; align-items:center; justify-content:center;
  transform:rotate(-6deg);
}
.shout-seal-inner {
  width:46rpx; height:46rpx; display:flex; align-items:center; justify-content:center;
  background:#c0392b; color:#f3e3c0; font-size:28rpx; font-weight:bold;
  border-radius:6rpx; box-shadow:0 2rpx 8rpx rgba(0,0,0,.55);
  animation: sealStamp .42s ease-out;
}
@keyframes sealStamp {
  0% { opacity:0; transform:scale(.3); }
  35% { opacity:1; transform:scale(1.18); }
  100% { opacity:.96; transform:scale(1); }
}
.popup-fx { position:fixed; left:50%; top:45%; transform:translateX(-50%); z-index:65; font-size:48rpx; font-weight:bold; pointer-events:none; animation:fxIn .25s ease-out; }
.popup-fx.heal { color:#79e6a0; }
.popup-fx.hit { color:#ff8a6b; }

/* ===== 角色卡动效层（CSS 动画，无 DOM 操作） ===== */
.seat.shake, .my-card.shake { animation: plShake .42s ease; }
@keyframes plShake {
  0%,100% { transform: translateX(0); }
  18% { transform: translateX(-7rpx); }
  38% { transform: translateX(6rpx); }
  58% { transform: translateX(-4rpx); }
  78% { transform: translateX(3rpx); }
}
.seat.glow, .my-card.glow { animation: plGlow .7s ease; }
@keyframes plGlow {
  0% { box-shadow: 0 0 0 rgba(121,230,160,0); }
  45% { box-shadow: 0 0 24rpx rgba(121,230,160,.85); }
  100% { box-shadow: 0 0 0 rgba(121,230,160,0); }
}

.fxlayer { position:absolute; inset:0; overflow:hidden; pointer-events:none; }
.fx { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; pointer-events:none; }

/* 全局特效层 */
.fxglobal { position:fixed; inset:0; pointer-events:none; z-index:68; overflow:hidden; }
.gfx { position:absolute; inset:0; }
/* 全屏斜斩 */
.gfx-slash {
  background: linear-gradient(115deg, transparent 44%, var(--col,#e8c66a) 50%, #fff 52%, var(--col,#e8c66a) 54%, transparent 60%);
  animation: gfxSlash .48s ease-out forwards; mix-blend-mode: screen;
}
@keyframes gfxSlash { 0%{opacity:0; transform:translateX(-30%);} 25%{opacity:1;} 100%{opacity:0; transform:translateX(30%);} }
/* 万剑归宗：天降剑雨 */
.gfx-swordrain { background: radial-gradient(circle at 50% 40%, rgba(143,216,255,.18), transparent 70%); }
.gfx-swordrain .rain {
  position:absolute; top:-12%; font-size:44rpx; color:#8fd8ff; font-weight:bold;
  text-shadow:0 0 10rpx #8fd8ff; opacity:0; animation: rainFall 1.5s linear forwards;
}
.gfx-swordrain .r1 { left:12%; animation-delay:0s; }
.gfx-swordrain .r2 { left:30%; animation-delay:.18s; }
.gfx-swordrain .r3 { left:48%; animation-delay:.32s; }
.gfx-swordrain .r4 { left:66%; animation-delay:.46s; }
.gfx-swordrain .r5 { left:84%; animation-delay:.6s; }
.gfx-swordrain .r6 { left:55%; animation-delay:.74s; }
@keyframes rainFall { 0%{opacity:0; transform:translateY(-20rpx);} 20%{opacity:1;} 100%{opacity:0; transform:translateY(120vh);} }

/* ===== 战报浮窗（右下角小浮标 + 弹出式浮层） ===== */
.log-fab {
  position:fixed; right:200rpx; bottom:280rpx; z-index:13;
  display:flex; align-items:center; justify-content:center;
  width:72rpx; height:72rpx; border-radius:50%;
  background:rgba(20,17,15,.88); border:1rpx solid #6a5328;
  color:#c9a24b; font-size:24rpx; letter-spacing:2rpx;
  box-shadow:0 4rpx 14rpx rgba(0,0,0,.55);
}
.log-fab.on { background:#3a2f23; border-color:#c9a24b; color:#e8c66a; }
.log-fab-t { font-weight:bold; }
.log-fab-n {
  position:absolute; right:-6rpx; top:-6rpx; min-width:28rpx; height:28rpx;
  padding:0 8rpx; border-radius:14rpx; background:#a02a3f; color:#f4ead0;
  font-size:18rpx; font-weight:bold; line-height:28rpx; text-align:center;
  border:1rpx solid #f4ead0;
}
.log-pop {
  position:fixed; left:30rpx; right:30rpx; bottom:380rpx; z-index:14;
  max-height:50vh; background:rgba(20,17,15,.94);
  border:1rpx solid #6a5328; border-radius:14rpx;
  box-shadow:0 8rpx 28rpx rgba(0,0,0,.7);
  display:flex; flex-direction:column; overflow:hidden;
}
.log-pop-h {
  display:flex; align-items:center; justify-content:space-between;
  padding:10rpx 18rpx; font-size:22rpx; color:#c9a24b; letter-spacing:4rpx;
  border-bottom:1rpx solid #3a2f23;
}
.log-pop-x {
  font-size:26rpx; color:#8a7e6c; padding:0 8rpx;
}
.log-pop-b { flex:1; padding:14rpx 18rpx; box-sizing:border-box; }
.log-pop-b .lg { font-size:22rpx; line-height:1.7; color:#cabf9f; }
.log-pop-b .lg-sys { color:#9ed4be; }
.log-pop-b .lg-big { color:#e8c66a; font-weight:bold; }
.log-pop-b .lg-hit { color:#ff8a6b; }
.log-pop-b .lg-heal { color:#79e6a0; }

/* ===== 技能按钮（默认折叠成右下"技"+数字浮标，点击展开面板） ===== */
.skill-fab {
  position:fixed; right:30rpx; bottom:200rpx; z-index:13;
  display:flex; align-items:center; justify-content:center;
  width:72rpx; height:72rpx; border-radius:50%;
  background:rgba(20,17,15,.88); border:2rpx solid #c9a24b;
  color:#e8c66a; font-size:24rpx; letter-spacing:2rpx; font-weight:bold;
  box-shadow:0 4rpx 14rpx rgba(0,0,0,.55);
}
.skill-fab-t { font-weight:bold; }
.skill-fab-n {
  position:absolute; right:-6rpx; top:-6rpx; min-width:28rpx; height:28rpx;
  padding:0 8rpx; border-radius:14rpx; background:#c9a24b; color:#14110f;
  font-size:18rpx; font-weight:bold; line-height:28rpx; text-align:center;
  border:1rpx solid #14110f;
}
.skill-pop {
  position:fixed; left:30rpx; right:30rpx; bottom:300rpx; z-index:14;
