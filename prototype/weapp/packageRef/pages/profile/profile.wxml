<view class="pf" wx:if="{{v.ready}}">

  <view class="pf-head">
    <view class="pf-mark">剑来</view>
    <view class="pf-title">{{v.title}}</view>
    <view class="pf-greet">{{v.greet}}</view>
  </view>

  <!-- 道途择定 -->
  <view class="pf-sec">择 道 途<text class="pf-sec-sp">点选即定 · 不可改途，只向前修</text></view>
  <view class="pf-paths">
    <view class="pf-path {{item.on?'on':''}}" wx:for="{{v.paths}}" wx:key="key" data-key="{{item.key}}" bindtap="pick">
      <view class="pf-path-n">{{item.name}}</view>
      <view class="pf-path-sub">{{item.sub}}</view>
      <view class="pf-path-desc">{{item.desc}}</view>
    </view>
  </view>

  <!-- 当前道途进度 -->
  <block wx:if="{{v.hasPath}}">
    <view class="pf-prog">
      <view class="pf-prog-top">
        <text>道行 {{v.xp}}</text><text>{{v.progress}}%</text>
      </view>
      <view class="pf-bar"><view class="pf-bar-fill" style="width:{{v.progress}}%"></view></view>
    </view>
    <view class="pf-gains" wx:if="{{v.gains.length}}">
      <view class="pf-gain" wx:for="{{v.gains}}" wx:key="n">
        <text class="pf-gain-n">{{item.n}}</text><text class="pf-gain-cls">{{item.cls}}</text>
        <view class="pf-gain-q">{{item.q}}</view>
      </view>
    </view>
    <view class="pf-next" wx:if="{{v.next}}">下一境 · {{v.next.name}}　尚差道行 {{v.next.far}}</view>
  </block>

  <!-- 境界图鉴 -->
  <view class="pf-seg">
    <view class="pf-seg-i {{v.ladderKind==='LQ'?'on':''}}" data-w="LQ" bindtap="setLadder">练气士十五境</view>
    <view class="pf-seg-i {{v.ladderKind==='WU'?'on':''}}" data-w="WU" bindtap="setLadder">武道十三境</view>
  </view>
  <view class="pf-ladder">
    <view class="pf-rl {{item.isNow?'now':''}} {{item.unlocked?'unlocked':''}}" wx:for="{{v.ladderKind==='LQ'?v.ladderLQ:v.ladderWU}}" wx:key="i">
      <view class="pf-rl-i">{{item.i}}</view>
      <view class="pf-rl-body">
        <view class="pf-rl-top">
          <text class="pf-rl-n">{{item.n}}</text>
          <text class="pf-rl-grp">{{item.grp}}</text>
          <text class="pf-rl-tag" wx:if="{{item.lost}}">失传</text>
          <text class="pf-rl-tag now" wx:if="{{item.isNow}}">此境</text>
        </view>
        <view class="pf-rl-d">{{item.d}}</view>
      </view>
    </view>
  </view>

  <!-- 个人行迹 -->
  <view class="pf-sec">个 人 行 迹<text class="pf-sec-sp">跨模块累积 · 论功不辍</text></view>
  <view class="pf-stats">
    <view class="pf-stat"><view class="b">{{v.stats.batt.total}}</view><view class="t">战局</view></view>
    <view class="pf-stat"><view class="b">{{v.stats.batt.win}}</view><view class="t">胜</view></view>
    <view class="pf-stat"><view class="b">{{v.stats.batt.lose}}</view><view class="t">负</view></view>
    <view class="pf-stat"><view class="b">{{v.stats.batt.best}}</view><view class="t">最高连胜</view></view>
  </view>
  <view class="pf-row">道行 <text class="b">{{v.xp}}</text>　·　包袱斋雪花钱 <text class="b">{{v.stats.baofuCoin}}</text></view>
  <view class="pf-row">人物志 <text class="b">{{v.stats.codex}}</text> 人　·　无事牌 <text class="b">{{v.stats.wsp}}</text> 面</view>
  <view class="pf-row">已走结局　书简湖 {{v.stats.seenAsklake}} · 落魄山 {{v.stats.seenSect}} · 山水祠 {{v.stats.seenShenci}}</view>

  <view class="pf-acts">
    <button class="btn sm" bindtap="recordWin">录 一 胜（论功）</button>
    <button class="btn sm ghost" bindtap="randomName">随机道号</button>
  </view>

  <view class="pf-sec" wx:if="{{v.log.length}}">破 境 · 论 功 录</view>
  <view class="pf-log">
    <view class="pf-lg" wx:for="{{v.log}}" wx:key="t">
      <text class="pf-lg-t">{{item.t}}</text>
      <text class="pf-lg-s">{{item.s}}</text>
      <text class="pf-lg-x" wx:if="{{item.x>0}}">+{{item.x}}</text>
    </view>
  </view>

  <view class="pf-foot"><button class="btn ghost" bindtap="back">回 到 卷 首</button></view>
</view>
