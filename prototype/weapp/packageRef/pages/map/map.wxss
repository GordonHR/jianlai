.mp {
  min-height: 100%;
  padding: 24rpx 20rpx 60rpx;
  color: #ece6d8;
  animation: pageIn .18s ease both;
}

/* 引言卡 */
.mp-intro {
  background: rgba(20,17,15,.55); border: 1rpx solid rgba(232,198,106,.22);
  border-left: 6rpx solid #e8c66a; border-radius: 14rpx; padding: 20rpx 22rpx; margin-bottom: 20rpx;
}
.mp-intro-t { font-family: "KaiTi","STKaiti",serif; font-size: 34rpx; color: #e8c66a; letter-spacing: 4rpx; margin-bottom: 10rpx; }
.mp-intro-d { font-size: 24rpx; color: #b9ad8f; line-height: 1.8; }

/* 分区标题 */
.mp-sec {
  font-family: "KaiTi","STKaiti",serif; font-size: 32rpx; color: #e8c66a; letter-spacing: 4rpx;
  border-left: 6rpx solid #e8c66a; padding-left: 16rpx; margin: 26rpx 0 14rpx;
}
.mp-sec-sp { font-family: inherit; font-size: 22rpx; color: #b9ad8f; letter-spacing: 1rpx; margin-left: 12rpx; }

/* 卡片网格 */
.mp-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300rpx, 1fr)); gap: 16rpx; }
@media (max-width: 680rpx) { .mp-grid { grid-template-columns: 1fr; } }

.mp-card {
  background: rgba(20,17,15,.55); border: 1rpx solid rgba(232,198,106,.22);
  border-radius: 16rpx; padding: 22rpx 22rpx; position: relative;
}
.mp-card:active { background: rgba(232,198,106,.10); }
.mp-card-n { font-family: "KaiTi","STKaiti",serif; font-size: 34rpx; color: #f0e6cc; letter-spacing: 3rpx; }
.mp-card-s { font-size: 22rpx; color: #b9ad8f; margin-top: 8rpx; line-height: 1.6; }
.mp-card.lizhu { border-color: #e8c66a; background: rgba(232,198,106,.10); }
.mp-card.manhuang { border-color: rgba(156,59,46,.5); }

/* 顶部返回 */
.mp-head { display: flex; align-items: flex-start; gap: 16rpx; padding-bottom: 16rpx; margin-bottom: 8rpx; border-bottom: 1rpx solid rgba(232,198,106,.3); }
.mp-back {
  font-size: 26rpx; color: #e8c66a; border: 1rpx solid rgba(232,198,106,.4);
  border-radius: 10rpx; padding: 10rpx 18rpx; flex: none; letter-spacing: 1rpx;
}
.mp-title { font-family: "KaiTi","STKaiti",serif; font-size: 44rpx; color: #e8c66a; letter-spacing: 6rpx; }
.mp-sub { font-size: 23rpx; color: #b9ad8f; margin-top: 6rpx; letter-spacing: 1rpx; }

/* 要地小卡 */
.mp-place {
  background: rgba(20,17,15,.55); border: 1rpx solid rgba(232,198,106,.22);
  border-radius: 14rpx; padding: 18rpx 18rpx; position: relative;
}
.mp-place:active { background: rgba(232,198,106,.10); }
.mp-place-tag {
  display: inline-block; font-size: 20rpx; color: #cdb98a; border: 1rpx solid rgba(232,198,106,.3);
  border-radius: 14rpx; padding: 1rpx 12rpx; margin-bottom: 10rpx;
}
.mp-place-n { font-family: "KaiTi","STKaiti",serif; font-size: 32rpx; color: #f0e6cc; letter-spacing: 2rpx; }

/* 通用房间卡（势力/航路/地点简述） */
.mp-room {
  background: rgba(20,17,15,.5); border: 1rpx solid rgba(232,198,106,.2);
  border-radius: 14rpx; padding: 18rpx 20rpx; margin-bottom: 14rpx;
}
.mp-room-n { font-family: "KaiTi","STKaiti",serif; font-size: 30rpx; color: #f0e6cc; letter-spacing: 2rpx; }
.mp-via { font-size: 22rpx; color: #cdb98a; margin-left: 8rpx; letter-spacing: 0; }
.mp-room-d { font-size: 24rpx; color: #b9ad8f; line-height: 1.75; margin-top: 8rpx; }

/* 标签 chips */
.mp-chips { display: flex; flex-wrap: wrap; gap: 12rpx; }
.mp-chip {
  font-size: 24rpx; color: #cdb98a; border: 1rpx solid rgba(232,198,106,.3);
  border-radius: 16rpx; padding: 8rpx 18rpx; background: rgba(232,198,106,.04);
}
.mp-chip.on { color: #e8c66a; border-color: #e8c66a; background: rgba(232,198,106,.12); }

.mp-foot { font-size: 22rpx; color: #8a7f5f; margin-top: 18rpx; line-height: 1.7; }

/* 详情浮层 */
.mp-sheet-mask { position: fixed; inset: 0; background: rgba(0,0,0,.55); z-index: 50; }
.mp-sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 51; max-height: 72%;
  background: #1a1612; border-top: 2rpx solid #e8c66a; border-radius: 20rpx 20rpx 0 0;
  display: flex; flex-direction: column;
  animation: mpSheetUp .2s ease both;
}
@keyframes mpSheetUp { 0%{transform: translateY(100%);} 100%{transform: translateY(0);} }
.mp-sheet-hd { display: flex; align-items: center; justify-content: space-between; padding: 22rpx 24rpx 14rpx; border-bottom: 1rpx solid rgba(232,198,106,.22); }
.mp-sheet-tag { font-size: 22rpx; color: #cdb98a; border: 1rpx solid rgba(232,198,106,.3); border-radius: 14rpx; padding: 2rpx 14rpx; margin-right: 14rpx; }
.mp-sheet-n { font-family: "KaiTi","STKaiti",serif; font-size: 38rpx; color: #f0e6cc; letter-spacing: 3rpx; }
.mp-sheet-x { font-size: 30rpx; color: #8a7f5f; width: 56rpx; height: 56rpx; line-height: 56rpx; text-align: center; flex: none; }
.mp-sheet-bd { padding: 20rpx 24rpx 40rpx; overflow: auto; }
.mp-sheet-d { font-size: 25rpx; color: #d8cfb6; line-height: 1.85; }
.mp-chars { margin-top: 22rpx; }
.mp-chars-t { font-size: 24rpx; color: #9a917f; margin-bottom: 12rpx; letter-spacing: 1rpx; }
