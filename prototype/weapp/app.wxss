/* 诊断 §4.1：去掉 background-attachment:fixed。
   webview 对 fixed 背景支持差，且滚动时整屏渐变反复重绘 → 低端机掉帧费电。
   改为随内容流的普通背景（一次性绘制）+ no-repeat 防平铺串纹；
   三层柔光锚点由"视口"改为"页面盒"，首屏观感一致，滚动零重绘。 */
page {
  background-color: #14110f;
  background-image:
    radial-gradient(1200px 600px at 50% 0%, #3a2f4a 0%, transparent 60%),
    radial-gradient(900px 500px at 8% 100%, #2a3a44 0%, transparent 55%),
    radial-gradient(900px 500px at 92% 100%, #432a2a 0%, transparent 55%),
    linear-gradient(160deg, #15131c 0%, #1d1a26 50%, #14110f 100%);
  background-repeat: no-repeat;
  min-height: 100%;
  color: #ece6d8;
  font-family: "PingFang SC", "Microsoft YaHei", serif;
}
view, text, button, input { box-sizing: border-box; }
.btn {
  border: 1px solid rgba(232,198,106,.5);
  background: rgba(232,198,106,.12);
  color: #e8c66a;
  border-radius: 10rpx;
  padding: 14rpx 28rpx;
  font-size: 28rpx;
}
.btn.primary { background: linear-gradient(180deg,#e8c66a,#b8893b); color:#1a140c; border:none; font-weight:600; }
.btn.ghost { background: transparent; border-color: rgba(236,230,216,.3); color:#cdc4b0; }
.btn[disabled] { opacity:.4; }

/* ============ 交互体验优化（剑来诊断 §3） ============ */
/* 3.1 统一可点区下限，避免误触；动作按钮 88rpx，紧凑控件 72rpx（不撑爆顶栏） */
.btn, .seal-btn, .skill {
  min-height: 88rpx;
  display: flex; align-items: center; justify-content: center;
  box-sizing: border-box;
}
.bg-btn, .float-btn {
  min-height: 72rpx;
  display: inline-flex; align-items: center; justify-content: center;
  box-sizing: border-box;
}
.btn:active, .seal-btn:active, .skill:active, .bg-btn:active, .float-btn:active { filter: brightness(.9); }

/* 3.4 内容图深色占位 + 载入淡入（仅作用于照片类，避开 SVG 图标，消除白闪） */
@keyframes imgIn { from { opacity:0 } to { opacity:1 } }
.seat-img, .my-img, .cx-img, .cx-dimg, .rsmvpi, .rslci,
.ts-bg, .sc-wish-img, .sect-end-img, .sect-prologue-img, .sect-portrait, .fig-portrait,
.charimg, .rimg, .lk-il-img, .wsp-art {
  background: #2a2118;
  animation: imgIn .3s ease both;
}

/* 3.5 模块切换轻量淡入（仅 opacity，避免 transform 影响 fixed 弹层定位） */
@keyframes pageIn { from { opacity:0 } to { opacity:1 } }
.title-screen, .setup, .game, .codex, .lake, .sect, .sc, .wsp {
  animation: pageIn .18s ease both;
}
