/* 符箓图鉴 · 小程序端（纯文字，无图；与 PC fulu.js 数据 1:1） */
.fulu { padding:22rpx 24rpx 40rpx; background:#1c1610; border:1px solid #3a2f23;
        border-radius:20rpx; margin:18rpx 20rpx; box-sizing:border-box; }

.fl-bar { display:flex; align-items:center; justify-content:space-between; margin:6rpx 0 14rpx; }
.fl-bar .btn { padding:10rpx 30rpx; font-size:26rpx; border-radius:10rpx; letter-spacing:4rpx; }
.fl-count { font-family:var(--kai); font-size:22rpx; color:#8a7e6c; letter-spacing:1rpx; }

.fl-hint { font-size:23rpx; line-height:1.7; color:#9a8f7c; margin:0 0 16rpx; }

.fl-sys { margin:6rpx 0 18rpx; padding:16rpx 18rpx; background:rgba(20,17,15,.5);
          border:1px solid rgba(232,198,106,.22); border-radius:10rpx; }
.fl-sys-h { font-family:var(--kai); letter-spacing:6rpx; color:#e8cf8f; margin-bottom:10rpx; font-size:26rpx; }
.fl-sys-p { font-size:22rpx; line-height:1.75; color:#c3bdac; margin:0 0 10rpx; }
.fl-sys-p .fl-b { color:#e8cf8f; margin-right:10rpx; }
.fl-sys-note { font-size:20rpx; color:#9a917f; font-style:italic; line-height:1.7; }

.fl-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:18rpx 16rpx; }
.fl-card { background:linear-gradient(180deg,#221c26,#151119); border:1px solid #5a4a2e;
           border-radius:10rpx; padding:10rpx 10rpx 14rpx; text-align:center; overflow:hidden; }
.fl-thumb { width:100%; height:220rpx; border-radius:8rpx; background:#1a1410; margin-bottom:8rpx; }
.fl-name { font-family:var(--kai); font-size:26rpx; letter-spacing:2rpx; color:#e8cf8f; }
.fl-alias { font-size:18rpx; color:#9a917f; margin-left:8rpx; letter-spacing:0; }
.fl-type { font-size:18rpx; color:#8d8574; margin-top:6rpx; }

/* 详情层 */
.fl-dt { position:fixed; inset:0; z-index:60; display:flex; align-items:center; justify-content:center; }
.fl-dt-scrim { position:absolute; inset:0; background:rgba(10,8,6,.74); }
.fl-fly { position:absolute; left:50%; top:38%; width:280rpx; height:380rpx; margin:-190rpx 0 0 -140rpx;
          z-index:70; pointer-events:none; opacity:0; transform:scale(.35) rotate(-18deg); }
.fl-fly.on { animation:flFly .52s cubic-bezier(.2,.85,.3,1) both; }
.fl-fly-img { width:100%; height:100%; border-radius:12rpx; box-shadow:0 0 40rpx rgba(232,198,106,.55); }
@keyframes flFly {
  0%   { opacity:0; transform:scale(.25) translateY(120rpx) rotate(-28deg); filter:blur(4px); }
  45%  { opacity:1; transform:scale(1.15) translateY(-20rpx) rotate(6deg); filter:blur(0); }
  100% { opacity:1; transform:scale(1) translateY(0) rotate(0); filter:blur(0); }
}
.fl-dt-card { position:relative; width:80%; max-width:640rpx; max-height:82%; overflow-y:auto;
              border-radius:18rpx; padding:24rpx 28rpx 32rpx; box-sizing:border-box;
              background:linear-gradient(168deg,#2a2330,#171320);
              border:2rpx solid rgba(232,198,106,.5);
              box-shadow:0 26rpx 70rpx rgba(0,0,0,.62), inset 0 0 26rpx 6rpx rgba(255,222,150,.18);
              opacity:0; transform:scale(.96); }
.fl-dt-card.show { animation:flCard .35s .22s ease both; }
@keyframes flCard { from { opacity:0; transform:scale(.96);} to { opacity:1; transform:scale(1);} }
.fl-dt-img { width:100%; border-radius:12rpx; margin-bottom:16rpx; background:#1a1410; }
.fl-dt-name { font-family:var(--kai); font-size:36rpx; letter-spacing:4rpx; color:#e8cf8f; text-align:center; }
.fl-dt-alias { font-size:22rpx; color:#9a917f; margin-left:12rpx; letter-spacing:0; }
.fl-dt-type { text-align:center; font-size:21rpx; color:#8d8574; margin:8rpx 0 18rpx; }
.fl-dt-row { display:flex; font-size:24rpx; line-height:1.8; color:#d4cdba; margin:0 0 14rpx; }
.fl-dt-b { color:#e8cf8f; flex:none; min-width:64rpx; margin-right:14rpx; }
.fl-dt-v { flex:1; }
.fl-dt-src { color:#9a917f; font-size:21rpx; }
